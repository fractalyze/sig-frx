"""sig-frx — FRX-native digital signatures.

bzlmod module. bazel 9 dropped WORKSPACE support, so dependencies and the
hermetic Python toolchain are declared here rather than in WORKSPACE.bazel.
"""

module(
    name = "sig_frx",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# The version MVS resolves anyway — protobuf, in rules_python's own dependency
# graph, requires it. Declaring the lower version only adds a
# direct-dependency-mismatch warning to every invocation.
bazel_dep(name = "rules_python", version = "1.7.0")

# Bazel 9 removed the native cc rules from the global namespace, so the Falcon
# interop oracle — the only C this repo builds — needs this explicitly.
bazel_dep(name = "rules_cc", version = "0.2.17")

# The symmetric layer every scheme in this repo hashes through. It rides the
# bzlmod module graph pinned to a commit rather than the pip lock: hash-frx is a
# Bazel module and publishes no wheel, and a commit pin is exact, needs no
# package index, and exposes `@hash_frx//hash_frx:...` targets directly.
#
# The cost is a second pip hub — hash-frx resolves frx from its own lock — so the
# two locks pin the same frx build (see //:requirements.in). Skew there puts two
# different frx copies on one test's sys.path.
#
# To build against a local hash-frx checkout instead of the pin:
#   echo 'common --override_module=hash_frx=/abs/path/to/hash-frx' >> .bazelrc.user
bazel_dep(name = "hash_frx", version = "0.0.0")
git_override(
    module_name = "hash_frx",
    commit = "aa085b8b72619778bf6193be849cd6b654178d07",
    remote = "https://github.com/fractalyze/hash-frx.git",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # frx / frxlib / frx-cuda12-pjrt / frx-cuda12-plugin are published on the
    # Fractalyze index.
    extra_pip_args = ["--extra-index-url=https://fractalyze.github.io/pypi/simple/"],
    hub_name = "sig_frx_pip",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock_3_11.txt",
)
use_repo(pip, "sig_frx_pip")

# Known-answer vectors are fetched and pinned, never committed. The published
# sets for the schemes this repo targets run to tens of megabytes — SLH-DSA
# sigGen's expected results alone are 31 MB — which is a permanent tax on every
# clone, forever, for data that never changes after publication. `http_file`
# pins content by sha256, so a corrupted or swapped fetch fails the build, and
# the repository cache makes every build after the first offline.
#
# The URLs are pinned to one ACVP-Server commit rather than a branch: NIST
# regenerates these files, and a moving URL would turn a vector regeneration
# upstream into a mystery failure here. Bumping the commit is a deliberate
# change with the diff visible in the sha256s.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Falcon is gated on an implementation rather than on a file, which
# docs/reference/testing.md allows when a standard publishes no vectors of its
# own: FN-DSA is still draft, so the authority is "the reference implementation
# the standard points at". Verifying the reference's signatures needs only its
# published KAT, which is transcribed in
# //sig_frx/lattice/falcon/testing:falcon_vectors — but the reverse direction,
# a key generated *here* being accepted *there*, needs that implementation
# running, so the source archive is fetched and its C compiled.
#
# The sha256 is the same pin `falcon_vectors.py` records for the values it
# transcribes, so the vectors and the oracle are gated on one artifact. The URL
# carries no commit to pin to: the round-3 submission is frozen by the NIST
# process, which is what stands in for one.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "falcon_round3",
    build_file = "//sig_frx/lattice/falcon/testing:falcon_round3.BUILD",
    sha256 = "d625407dbda9e5835f610aaeba1147e029988a6610e0107dfd292033138e1d47",
    strip_prefix = "falcon-round3",
    urls = ["https://falcon-sign.info/falcon-round3.zip"],
)

# The ACVP JSON split: prompt.json carries the inputs, expectedResults.json the
# outputs, joined on (tgId, tcId). Both halves are needed for one vector set.
http_file(
    name = "acvp_slh_dsa_keygen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "bce170976f257ee3dfc8c54ea46722ccb553539847daa6d8048f0216cc28b51c",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-keyGen-FIPS205/prompt.json"],
)

http_file(
    name = "acvp_slh_dsa_keygen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "f35f74b6676d6b369c87e88c36698f28c14d5929d31e507d910288c69258afee",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-keyGen-FIPS205/expectedResults.json"],
)

# The SLH-DSA signature sets. Between them they cover every operation FIPS 205
# defines — the pure and pre-hash external interfaces and §9's internal one, in
# both the deterministic and the hedged mode — which is why they are what a
# signing and verifying implementation is gated on rather than keyGen alone.
#
# These are the two files the storage decision above was written for: sigGen's
# expected results are 32 MB of signatures and sigVer's prompts 30 MB of them,
# because a signature at the largest parameter set is 49 856 bytes and the sets
# carry 624 and 504 cases.
http_file(
    name = "acvp_slh_dsa_siggen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "afa673eacdf0aec53512a159159b7632684adfcd0d88f8640a7f6f5796aacdc8",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigGen-FIPS205/prompt.json"],
)

http_file(
    name = "acvp_slh_dsa_siggen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "71e8e0f7e4b0cfd1747314299204d9d4d50968d200a4ae873921eaa7aabeaad1",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigGen-FIPS205/expectedResults.json"],
)

