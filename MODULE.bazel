"""sig-frx — FRX-native digital signatures.

bzlmod module. bazel 9 dropped WORKSPACE support, so dependencies and the
hermetic Python toolchain are declared here rather than in WORKSPACE.bazel.
"""

module(
    name = "sig_frx",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# The version MVS resolves anyway — protobuf, in rules_python's own dependency
# graph, requires it. Declaring the lower version only adds a
# direct-dependency-mismatch warning to every invocation.
bazel_dep(name = "rules_python", version = "1.7.0")

# The symmetric layer every scheme in this repo hashes through. It rides the
# bzlmod module graph pinned to a commit rather than the pip lock: hash-frx is a
# Bazel module and publishes no wheel, and a commit pin is exact, needs no
# package index, and exposes `@hash_frx//hash_frx:...` targets directly.
#
# The cost is a second pip hub — hash-frx resolves frx from its own lock — so the
# two locks pin the same frx build (see //:requirements.in). Skew there puts two
# different frx copies on one test's sys.path.
#
# To build against a local hash-frx checkout instead of the pin:
#   echo 'common --override_module=hash_frx=/abs/path/to/hash-frx' >> .bazelrc.user
bazel_dep(name = "hash_frx", version = "0.0.0")
git_override(
    module_name = "hash_frx",
    commit = "0d66fc69b426e0c3ee7e6af8b8383b5744d5229c",
    remote = "https://github.com/fractalyze/hash-frx.git",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # frx / frxlib / frx-cuda12-pjrt / frx-cuda12-plugin are published on the
    # Fractalyze index.
    extra_pip_args = ["--extra-index-url=https://fractalyze.github.io/pypi/simple/"],
    hub_name = "sig_frx_pip",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock_3_11.txt",
)
use_repo(pip, "sig_frx_pip")

# Known-answer vectors are fetched and pinned, never committed. The published
# sets for the schemes this repo targets run to tens of megabytes — SLH-DSA
# sigGen's expected results alone are 31 MB — which is a permanent tax on every
# clone, forever, for data that never changes after publication. `http_file`
# pins content by sha256, so a corrupted or swapped fetch fails the build, and
# the repository cache makes every build after the first offline.
#
# The URLs are pinned to one ACVP-Server commit rather than a branch: NIST
# regenerates these files, and a moving URL would turn a vector regeneration
# upstream into a mystery failure here. Bumping the commit is a deliberate
# change with the diff visible in the sha256s.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# The ACVP JSON split: prompt.json carries the inputs, expectedResults.json the
# outputs, joined on (tgId, tcId). Both halves are needed for one vector set.
http_file(
    name = "acvp_slh_dsa_keygen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "bce170976f257ee3dfc8c54ea46722ccb553539847daa6d8048f0216cc28b51c",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-keyGen-FIPS205/prompt.json"],
)

http_file(
    name = "acvp_slh_dsa_keygen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "f35f74b6676d6b369c87e88c36698f28c14d5929d31e507d910288c69258afee",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-keyGen-FIPS205/expectedResults.json"],
)

# The SLH-DSA signature sets. Between them they cover every operation FIPS 205
# defines — the pure and pre-hash external interfaces and §9's internal one, in
# both the deterministic and the hedged mode — which is why they are what a
# signing and verifying implementation is gated on rather than keyGen alone.
#
# These are the two files the storage decision above was written for: sigGen's
# expected results are 32 MB of signatures and sigVer's prompts 30 MB of them,
# because a signature at the largest parameter set is 49 856 bytes and the sets
# carry 624 and 504 cases.
http_file(
    name = "acvp_slh_dsa_siggen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "afa673eacdf0aec53512a159159b7632684adfcd0d88f8640a7f6f5796aacdc8",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigGen-FIPS205/prompt.json"],
)

http_file(
    name = "acvp_slh_dsa_siggen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "71e8e0f7e4b0cfd1747314299204d9d4d50968d200a4ae873921eaa7aabeaad1",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigGen-FIPS205/expectedResults.json"],
)

# 72 of the 84 SLH-DSA-SHA2-128 cases here are published failures, and twelve of
# those carry a signature one byte short or long — which is the only thing that
# exercises Algorithm 20's length check, and the reason a wrong length has to be a
# verdict rather than an error.
http_file(
    name = "acvp_slh_dsa_sigver_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "4e7beb1233e47baa0acdd36417c66c45811aa40a4e32ffdb1a35d93b13b289fb",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigVer-FIPS205/prompt.json"],
)

http_file(
    name = "acvp_slh_dsa_sigver_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "259f5e2a0665de0adc0fefa45b5db3a2a6ed13c3c44d14bdaf64a80aee12c687",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/SLH-DSA-sigVer-FIPS205/expectedResults.json"],
)

# The ML-DSA keyGen set: 25 cases per parameter set, each a 32-byte `ξ` against
# the public and private keys it expands to. The widest gate here for its size —
# `ExpandA`, `ExpandS`, `Power2Round` and both key encodings have to agree for one
# published key to come back.
http_file(
    name = "acvp_ml_dsa_keygen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "43e81ad820e495dbcad086fe27c1008393a8c32100bbbff77c558c3f06dcefef",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-keyGen-FIPS204/prompt.json"],
)

http_file(
    name = "acvp_ml_dsa_keygen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "361f47ca19d592adcc66ff2cb591686ad785fea157b295648738bed6921a68df",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-keyGen-FIPS204/expectedResults.json"],
)

# The sigGen set is the only check the deterministic signing mode gets, and the
# only one the rejection loop gets: a signature is the loop's output at whichever
# iteration it accepted, so reproducing one pins every rejection that preceded it.
# Its 360 cases are 15 per (parameter set, interface, signing mode), where the
# interfaces are §5's pure external, §5.4's pre-hash external and §6's internal.
http_file(
    name = "acvp_ml_dsa_siggen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "447749d72817b211160d243311ce32302f3023e59c355b0f70be2bd3e9e7830d",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-sigGen-FIPS204/prompt.json"],
)

http_file(
    name = "acvp_ml_dsa_siggen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "228d011bbe274aeb93e22eea1e0d57b78f43795cf6a64fb5ef1e626485a0bedb",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-sigGen-FIPS204/expectedResults.json"],
)

# The sigVer set is what pins the negative-vector handling: 144 of its 180 cases
# are published failures, so a loader that dropped the verdict would turn them
# into 144 false positives.
http_file(
    name = "acvp_ml_dsa_sigver_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "aeba1135e5dbda1681369cc7a7598c3d53e492d1c9881098556ba4dbe067b376",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-sigVer-FIPS204/prompt.json"],
)

http_file(
    name = "acvp_ml_dsa_sigver_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "99c5b82abf37bdf6f7bd11c6976e4d8007d70f9953dc13566232404647865bb8",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-DSA-sigVer-FIPS204/expectedResults.json"],
)

# ECDSA's authority is Wycheproof: RFC 6979 covers P-256 with a handful of
# signatures and secp256k1 with none, and ACVP does not test secp256k1 at all.
# The `p1363` variants carry the fixed-width `r ‖ s` encoding the core speaks —
# the DER sets gate a parser this repo does not have. About a third of each set
# is published failures, which is the half of the gate self-made vectors cannot
# supply.
http_file(
    name = "wycheproof_ecdsa_secp256k1_p1363",
    downloaded_file_path = "ecdsa_secp256k1_sha256_p1363_test.json",
    sha256 = "7a339efc7134fb2495cd32afdbd692e0f86427d3c24e9073f6a7d858bb8788d2",
    urls = ["https://raw.githubusercontent.com/C2SP/wycheproof/dac1dd4729fd1f8dd9e1e9f3dce51d783da6c166/testvectors_v1/ecdsa_secp256k1_sha256_p1363_test.json"],
)

http_file(
    name = "wycheproof_ecdsa_secp256r1_p1363",
    downloaded_file_path = "ecdsa_secp256r1_sha256_p1363_test.json",
    sha256 = "c60de693930e386c3a5472d08081623ef8504decc54b38ac01ec6b2a2575c986",
    urls = ["https://raw.githubusercontent.com/C2SP/wycheproof/dac1dd4729fd1f8dd9e1e9f3dce51d783da6c166/testvectors_v1/ecdsa_secp256r1_sha256_p1363_test.json"],
)
