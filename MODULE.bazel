# published key to come back.
http_file(
    name = "acvp_ml_dsa_keygen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "43e81ad820e495dbcad086fe27c1008393a8c32100bbbff77c558c3f06dcefef",
