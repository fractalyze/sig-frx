# The sigGen set is the only check the deterministic signing mode gets, and the
# only one the rejection loop gets: a signature is the loop's output at whichever
# iteration it accepted, so reproducing one pins every rejection that preceded it.
# Its 360 cases are 15 per (parameter set, interface, signing mode), where the
# interfaces are §5's pure external, §5.4's pre-hash external and §6's internal.
http_file(
    name = "acvp_ml_dsa_siggen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "447749d72817b211160d243311ce32302f3023e59c355b0f70be2bd3e9e7830d",
