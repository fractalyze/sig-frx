load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The package marker. Carries `__version__`, which dev-release stamps; the
# scheme libraries (the Signature seam, SLH-DSA, ML-DSA, Falcon, XMSS, ECDSA,
# EdDSA) land alongside it and depend on this for the package init.
py_library(
    name = "sig_frx",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
)

# The one seam every scheme implements. Names no scheme and no hash, so a
# consumer can code against it before any scheme exists.
py_library(
    name = "signature",
    srcs = ["signature.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# Top level because both the hash-based and the lattice packages depend on it; in
# either one it would be a cross-package dependency the other pays for.
py_library(
    name = "arrays",
    srcs = ["arrays.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

# `:arrays`' rule applied to the hash rather than to the array module. Separate
# from `:arrays` because of what it costs to merge them: `:arrays` is what
# `:arith` and `:encoding` depend on for the namespace rule, and neither hashes,
# so folding the hash-frx dependency in there would charge it to every consumer
# of the rule rather than to the ones that pick a hash.
py_library(
    name = "hashes",
    srcs = ["hashes.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":arrays",
        "@hash_frx//hash_frx:byte_hash",
        "@hash_frx//hash_frx/keccak",
    ],
)

# The message framing FIPS 204 and FIPS 205 share. Top level for the same reason
# as `:arrays` — one scheme family per package, and both standards frame a
# context the same way.
py_library(
    name = "context",
    srcs = ["context.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The pre-hash variants' shared record, over `:context`'s framing. Top level
# because both standards define one and each scheme family is its own package.
py_library(
    name = "prehash",
    srcs = ["prehash.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":context",
        "@hash_frx//hash_frx:byte_hash",
        "@hash_frx//hash_frx:sha256",
        "@hash_frx//hash_frx/keccak",
        requirement("frx"),
        requirement("numpy"),
    ],
)
