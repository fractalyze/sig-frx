load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Sized from the legs rather than from a local run, which sizes nothing
# (../../../../docs/reference/measurement.md): the GPU leg measures 3.6 s here
# on a comparable device, which that page says is usable, and the CPU leg is
# what the merge gate records. `small`'s 60 s covers the worse of the two at
# well under half.
py_test(
    name = "fft_test",
    size = "small",
    srcs = ["fft_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:arith",
        "//sig_frx/lattice/falcon:fft",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor: 4.0 s on the CPU leg against 2.9 s on the GPU one, so
# CPU is the leg that decides and `small`'s 60 s covers it at 7%. The CPU leg's
# run-to-run spread is around 2.2x, which leaves a bad run near 15% — well
# inside the half-a-budget rule in ../../../../docs/reference/measurement.md.
#
# The workstation figure would have argued for `small` too, but it is not what
# decided this: a CUDA-less box refuses `FRX_PLATFORMS=cuda` rather than falling
# back, so the GPU leg was unmeasurable there and this waited for CI.
py_test(
    name = "arith_test",
    size = "small",
    srcs = ["arith_test.py"],
    deps = [
        ":falcon_reference",
        "//sig_frx/lattice/falcon:arith",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The specification's own algorithms, transcribed. Pure Python over unbounded
# integers, so it depends on nothing in the tree and both test targets can hold
# their reshaped counterparts to it.
py_library(
    name = "falcon_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_reference.py",
    ],
)

# Transcribed constants rather than a fetched file: Falcon publishes no ACVP set,
# so the authority is the reference implementation's own KAT and the provenance
# lives in the module. #28 replaces this with the pinned whole set. Depends on
# the harness because it hands its cases over as `kat.KatVector`.
#
# Visible to the rest of the lattice tree, not just to this package: Falcon
# cannot sign here yet, so these vectors are the only published signature a
# lattice-wide measurement can drive `verify` with, and
# `//sig_frx/lattice/testing:compaction_bench` is one. Scoped to `lattice` and
# not to `sig_frx` because no other family has a reason to read Falcon's KAT.
py_library(
    name = "falcon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_vectors.py",
    ],
    visibility = ["//sig_frx/lattice:__subpackages__"],
    deps = ["//sig_frx/testing:kat"],
)

# The published verdicts and everything the shared harness derives from them.
# Separate from `falcon_test` the way `ml_dsa_kat_test` is from `ml_dsa_test`:
# this one is the vectors, that one is the scheme's own structure.
#
# Sized from the executor, and the GPU leg decides here too: 172.1 s against the
# CPU leg's 81.3 s. `medium` would be 57% of its 300 s — past the half-a-budget
# rule in ../../../../docs/reference/measurement.md before any spread is counted
# — so it takes the same bucket as `falcon_test`, at 19% of 900 s. The harness
# derives a tampering and a batch pass per vector, each its own traced shape.
py_test(
    name = "falcon_kat_test",
    size = "large",
    srcs = ["falcon_kat_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor: 31.4 s on the CPU leg against 16.1 s on the GPU one,
# so CPU is the leg that decides — and that 31.4 is itself the CPU leg's spread
# showing, against 17.7 s for the same content on an earlier run. `small` would
# put the worse of those at 52% of its 60 s, past the half-a-budget rule in
# ../../../../docs/reference/measurement.md; `medium` covers it at 10%.
py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":falcon_reference",
        "//sig_frx/lattice/falcon:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor, and **the GPU leg is the one that decides** — 272.9 s
# against the CPU leg's 122.5 s. That inverts the sibling `arith_test`, where CPU
# is slower, and the cause is the cost `testing.md` attributes to distinct
# shapes rather than to vectors: each case carries its own message length, so
# nearly every one traces its own program, and a compile is what the GPU leg is
# worst at.
#
# `large`'s 900 s covers that worst run at 30%. `medium` would have been at 91%
# — a target that passes on a workstation and flakes where it counts, which is
# the whole of why a local number does not size a budget.
py_test(
    name = "falcon_test",
    size = "large",
    srcs = ["falcon_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx:signature",
        "//sig_frx/lattice/falcon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# What the decoder's GPU share is made of. Beside Falcon rather than beside the
# shared compaction's harness in //sig_frx/lattice/testing: that one is there
# because it reaches both schemes, and this reaches one. It takes the vectors
# for the reason that one does — Falcon cannot sign here yet, so a published
# signature is the only thing a `verify` measurement can be driven with.
py_binary(
    name = "decoder_bench",
    testonly = True,
    srcs = ["decoder_bench.py"],
    deps = [
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        "//sig_frx/lattice/falcon:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Provisionally sized, because no leg has recorded this target yet and
# ../../../../docs/reference/measurement.md says a workstation number sizes
# nothing. What the workstation does say is which leg will decide: the GPU one
# runs it at roughly twice the CPU one, the ratio the sibling `arith_test`
# shows and `falcon_test` inverts, and both are far enough inside `small` that
# no other bucket is arguable. Revisit against the first CI run — if the GPU leg
# lands past half of 60 s, this wanted `medium`.
py_test(
    name = "bigint_test",
    size = "small",
    srcs = ["bigint_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:bigint",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
