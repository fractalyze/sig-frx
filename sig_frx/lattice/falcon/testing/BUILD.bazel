load("@rules_python//python:defs.bzl", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# `medium` for a leg that has not been measured, not for the work. The CPU leg
# runs this in 4.2 s on a workstation, which projects to roughly 9-14 s on the
# executor and would fit `small`. The GPU leg is the one that decides and it is
# unmeasured — a CUDA-less box refuses `FRX_PLATFORMS=cuda` outright rather than
# falling back — and this compiles the transform at both degrees, which is the
# shape that has cost far more on that leg elsewhere in this repo.
#
# So this is the guess ../../../../docs/reference/conventions.md says a size is
# until the target runs on the leg; the first CI run replaces it with a number.
# Bazel will call it too big from a local run, which that page addresses.
py_test(
    name = "arith_test",
    size = "medium",
    srcs = ["arith_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:arith",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
