load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Sized from the executor: 4.0 s on the CPU leg against 2.9 s on the GPU one, so
# CPU is the leg that decides and `small`'s 60 s covers it at 7%. The CPU leg's
# run-to-run spread is around 2.2x, which leaves a bad run near 15% — well
# inside the half-a-budget rule in ../../../../docs/reference/conventions.md.
#
# The workstation figure would have argued for `small` too, but it is not what
# decided this: a CUDA-less box refuses `FRX_PLATFORMS=cuda` rather than falling
# back, so the GPU leg was unmeasurable there and this waited for CI.
py_test(
    name = "arith_test",
    size = "small",
    srcs = ["arith_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:arith",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The specification's own algorithms, transcribed. Pure Python over unbounded
# integers, so it depends on nothing in the tree and both test targets can hold
# their reshaped counterparts to it.
py_library(
    name = "falcon_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_reference.py",
    ],
)

# Transcribed constants rather than a fetched file: Falcon publishes no ACVP set,
# so the authority is the reference implementation's own KAT and the provenance
# lives in the module. #28 replaces this with the pinned whole set.
py_library(
    name = "falcon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_vectors.py",
    ],
)

# Sized from the executor: 17.7 s on the CPU leg against 11.5 s on the GPU one,
# so CPU is the leg that decides. `small` would sit at 30% of its 60 s, which
# the CPU leg's ~2.2x run-to-run spread takes to 65% on a bad run — past the
# half-a-budget rule in ../../../../docs/reference/conventions.md. `medium`
# covers the same worst run at 13%.
py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":falcon_reference",
        "//sig_frx/lattice/falcon:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor, and **the GPU leg is the one that decides** — 243.0 s
# against the CPU leg's 82.1 s. That inverts the sibling `arith_test`, where CPU
# is slower, and the cause is the cost `conventions.md` attributes to distinct
# shapes rather than to vectors: the published cases carry a different message
# length each, so nearly every one traces its own program, and a compile is what
# the GPU leg is worst at.
#
# `large`'s 900 s covers that worst run at 27%. `medium` would have been at 81%
# — a target that passes on a workstation at 48.6 s and flakes where it counts,
# which is the whole of why a local number does not size a budget.
py_test(
    name = "verify_test",
    size = "large",
    srcs = ["verify_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx:signature",
        "//sig_frx/lattice/falcon:verify",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
