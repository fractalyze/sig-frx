load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Sized from the legs rather than from a local run, which sizes nothing
# (../../../../docs/reference/measurement.md): the GPU leg measures 3.6 s here
# on a comparable device, which that page says is usable, and the CPU leg is
# what the merge gate records. `small`'s 60 s covers the worse of the two at
# well under half.
py_test(
    name = "fft_test",
    size = "small",
    srcs = ["fft_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:arith",
        "//sig_frx/lattice/falcon:fft",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor: 4.0 s on the CPU leg against 2.9 s on the GPU one, so
# CPU is the leg that decides and `small`'s 60 s covers it at 7%. The CPU leg's
# run-to-run spread is around 2.2x, which leaves a bad run near 15% — well
# inside the half-a-budget rule in ../../../../docs/reference/measurement.md.
#
# The workstation figure would have argued for `small` too, but it is not what
# decided this: a CUDA-less box refuses `FRX_PLATFORMS=cuda` rather than falling
# back, so the GPU leg was unmeasurable there and this waited for CI.
py_test(
    name = "arith_test",
    size = "small",
    srcs = ["arith_test.py"],
    deps = [
        ":falcon_reference",
        "//sig_frx/lattice/falcon:arith",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The specification's own algorithms, transcribed. Pure Python over unbounded
# integers, so it depends on nothing in the tree and both test targets can hold
# their reshaped counterparts to it.
py_library(
    name = "falcon_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_reference.py",
    ],
)

# The submission's whole KAT, fetched and sha256-pinned: Falcon publishes no ACVP
# set, so the authority is the reference implementation's own and the provenance
# lives in the module. Depends on the harness because it hands its cases over as
# `kat.KatVector`, and on the reference for §3.11.6's regrouping — which the
# oracle runs too, so it lives in the transcription rather than in either caller.
#
# Visible to the rest of the lattice tree, not just to this package: Falcon
# cannot sign here yet, so these vectors are the only published signature a
# lattice-wide measurement can drive `verify` with, and
# `//sig_frx/lattice/testing:compaction_bench` is one. Scoped to `lattice` and
# not to `sig_frx` because no other family has a reason to read Falcon's KAT.
py_library(
    name = "falcon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_vectors.py",
    ],
    data = ["@falcon_round3//:kat_vectors"],
    visibility = ["//sig_frx/lattice:__subpackages__"],
    deps = [
        ":falcon_reference",
        "//sig_frx/testing:kat",
        "@rules_python//python/runfiles",
    ],
)

# The published verdicts and everything the shared harness derives from them.
# Separate from `falcon_test` the way `ml_dsa_kat_test` is from `ml_dsa_test`:
# this one is the vectors, that one is the scheme's own structure.
#
# Sized from the executor. `falcon_kat_test.py` bounds the vectors per degree,
# and at that bound the merge gate records **393.1 s on the CPU leg against
# 192.0 s on the GPU one** — 44% of `large`'s 900 s, so the bucket stands and
# the half-a-budget rule in ../../../../docs/reference/measurement.md is not
# reached. The harness derives a tampering and a batch pass per vector, each its
# own traced shape, which is what the bound is bounding.
#
# **The deciding leg flipped when the bound doubled, and that is worth knowing
# before trusting an extrapolation here.** At the previous two vectors per degree
# this target ran 172.1 s on GPU against 81.3 s on CPU, so GPU decided; at four
# it is 192.0 s against 393.1 s, so CPU does. The GPU leg grew 1.12x for twice
# the vectors where the CPU leg grew 4.8x — the two legs do not scale alike, and
# a ratio measured on one of them does not carry to the other. A local run had
# predicted 250-344 s on the GPU leg from a 1.46x workstation ratio; the GPU
# number came in under that and the CPU number came in over it. Measure both.
py_test(
    name = "falcon_kat_test",
    size = "large",
    srcs = ["falcon_kat_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The exhaustive run: all 100 published records at both degrees, where the gate
# above takes a bounded few.
#
# `slow_kat`, so .bazelrc.ci drops it from a pull request and the scheduled CI
# run puts it back — the same trade `ml_dsa_sweep_test` and
# `slh_dsa_sweep_test` make, and for the same reason. What makes the bound
# necessary rather than merely tidy is that the generator varies `mlen` per
# record, so 100 records are 100 traced shapes per degree and the cost is
# ~50x the gate's rather than 50x its execution.
#
# **Bazel shards by test case, so the case split is the floor on the wall clock,
# and chunking the records to lower that floor was measured and is worse.**
# One `kat.check` per parameter set is two cases; `shard_count = 2` covers them
# and a higher count only allocates empty shards. Splitting each degree's
# records into four chunks — eight cases, `shard_count = 8` — was the obvious
# way to divide the slowest method, and locally it went the other way:
#
#   2 cases, 2 shards:  max 1016.5 s, min 575.8 s, avg  796.2 s  (~1592 s total)
#   8 cases, 8 shards:  max 1413.3 s, min 690.2 s, avg 1020.3 s  (~8162 s total)
#
# (A 4-shard run of the two-case form measured max 1001.5 s and the same ~1573 s
# total, the two extra shards being empty — which is the same reading as the
# first row and why `shard_count` is 2.)
#
# 1.41x the wall clock for 5.2x the compute. A shard is a process that re-pays
# the frx import, the backend init and the warm-up, and at 25 records that
# constant dominates the per-record work it was meant to divide. The floor is
# real; the way under it is fewer records per run, which is what the gate next
# door already does.
#
# These are workstation numbers and `slow_kat` keeps the target off every pull
# request, so `eternal` is sized against an unmeasured leg. The levers if it
# ever breaches: fewer records, or one target per degree so each is a single
# process over a single set. More shards is not one of them.
py_test(
    name = "falcon_sweep_test",
    size = "large",
    timeout = "eternal",
    srcs = ["falcon_sweep_test.py"],
    shard_count = 2,
    tags = ["slow_kat"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor: 31.4 s on the CPU leg against 16.1 s on the GPU one,
# so CPU is the leg that decides — and that 31.4 is itself the CPU leg's spread
# showing, against 17.7 s for the same content on an earlier run. `small` would
# put the worse of those at 52% of its 60 s, past the half-a-budget rule in
# ../../../../docs/reference/measurement.md; `medium` covers it at 10%.
py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor, and **the GPU leg is the one that decides** — 272.9 s
# against the CPU leg's 122.5 s. That inverts the sibling `arith_test`, where CPU
# is slower, and the cause is the cost `testing.md` attributes to distinct
# shapes rather than to vectors: each case carries its own message length, so
# nearly every one traces its own program, and a compile is what the GPU leg is
# worst at.
#
# `large`'s 900 s covers that worst run at 30%. `medium` would have been at 91%
# — a target that passes on a workstation and flakes where it counts, which is
# the whole of why a local number does not size a budget.
#
# Algorithm 4 adds one real key generation, and **the two legs do not pay the
# same for it**: this target went 178.7 s to 236.2 s on the CPU leg and 291.8 s
# to 380.7 s on the GPU one, measured with and without the case on one
# workstation. The extra on GPU is the dispatches Algorithm 5's loop makes per
# attempt — `invertible` is an opcode with no host form and there were 17
# attempts — where the solve itself is host arithmetic either way. 380.7 s is
# 42% of `large`.
#
# At `Falcon-512` alone, which is a budget decision rather than a coverage one:
# the degree does not change what the case asserts, and a `Falcon-1024` key
# measured 140 s against 46 s, because a solve can be spent and then thrown
# away by line 13.
#
# Algorithm 10's cases were added for free, and "free" is a decision rather than
# luck: they need a key, and generating a second one took the GPU leg to 425.4 s
# — 47%, which the leg's own 1.07x spread turns into a bad run past half. The
# pair is a pure function of its seed, so `falcon_test._key_pair` generates it
# once and both the key-generation case and the signing cases read it. Back to
# **353.0 s on the GPU leg and 297.5 s on the CPU one**, which is 39% of `large`
# and where this sat before signing existed. Every `sign` still rebuilds the
# ffLDL tree, because §3.11.5 encodes the trapdoor and not the tree — that cost
# is the seam's shape, not a fixture that could be hoisted too.
py_test(
    name = "falcon_test",
    size = "large",
    srcs = ["falcon_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx:signature",
        "//sig_frx/lattice/falcon",
        "//sig_frx/lattice/falcon:encoding",
        "//sig_frx/lattice/falcon:keygen",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# What the decoder's GPU share is made of. Beside Falcon rather than beside the
# shared compaction's harness in //sig_frx/lattice/testing: that one is there
# because it reaches both schemes, and this reaches one. It takes the vectors
# for the reason that one does — Falcon cannot sign here yet, so a published
# signature is the only thing a `verify` measurement can be driven with.
py_binary(
    name = "decoder_bench",
    testonly = True,
    srcs = ["decoder_bench.py"],
    deps = [
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        "//sig_frx/lattice/falcon:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor across two runs: 16.4-26.1 s on the CPU leg and
# 18.0-23.1 s on the GPU one. The worst of those is 26.1 s, which is 43% of
# `small`'s 60 s and so does not reach the half-a-budget threshold in
# ../../../../docs/reference/measurement.md.
#
# **Which leg decides is noise here**, and worth recording because it looks like
# signal: the two runs disagree about it, CPU slower in one and GPU slower in
# the other, with the pair never more than 13% apart. A comment naming one of
# them would be reversed by the next run.
py_test(
    name = "bigint_test",
    size = "small",
    srcs = ["bigint_test.py"],
    deps = [
        "//sig_frx/lattice/falcon:bigint",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Sized from the executor: 120.3 s on the CPU leg against 96.2 s on the GPU one.
# The worse of those is 40% of `medium`'s 300 s, inside the half-a-budget
# threshold in ../../../../docs/reference/measurement.md — but no longer
# comfortably. **The next slice that lands in this file probably tips it to
# `large`**: Algorithm 5's cases alone took the CPU leg from 84.1 s to 120.3 s,
# and the lift, Babai's reduction and the key encoding are all still to come.
#
# The workstation said the GPU leg would decide, at 1.6x the CPU one. CI has it
# the other way at 0.8x. That is the second time a local leg ratio has been
# reversed here — the sibling `bigint_test` records the first — so the ratio is
# worth measuring and not worth predicting.
#
# That threshold is *already* the executor's spread — the page sets it at half
# precisely because a CPU-leg duration varies by a median of 2.2x across runs of
# unchanged commits. Applying a spread factor on top of it, which is what sized
# this `large` to begin with, counts the same variance twice and buys a bucket
# nothing asked for.
#
# The cost is the module, not the oracle: a level's shapes depend on its width,
# so the descent compiles ten distinct programs per parameter set. Real key
# generation pays that once per key. The base case adds two more programs at
# 3,161 and 6,302 bits, which grew the target by at most 1.27x — 48.6 s without
# them against 56.6-61.8 s with, measured by running this same target both ways
# on one workstation. So the 84.1 s above scales to about 107 s. The ratio is
# what travels between machines; the seconds are the executor's, which is why
# the bucket is not re-derived from a local duration and a spread factor —
# doing that is what oversized this target once already.
#
# The walk back up costs 2.1x on top of that — 70.3 s against 146.6 s, this
# target run with and without its end-to-end cases on one workstation — because
# it adds two compiled programs per level and about 330 reduction steps at
# `n = 1024`. 2.1x on the 107 s above is ~224 s, which is 75% of `medium` and so
# past the half-a-budget threshold; `large` puts it at 25%.
#
# The ffLDL tree is the one slice that did not move any of this, which is worth
# recording because every slice before it did: its four cases run 1.2 s against
# the target's 130-146 s over two CPU runs on one workstation, about 1% either
# way. Nothing there compiles per level the way the integer half does — the tree
# is host `float64` — and its single traced case is one small program.
py_test(
    name = "keygen_test",
    size = "large",
    srcs = ["keygen_test.py"],
    deps = [
        ":falcon_reference",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon:arith",
        "//sig_frx/lattice/falcon:bigint",
        "//sig_frx/lattice/falcon:encoding",
        "//sig_frx/lattice/falcon:fft",
        "//sig_frx/lattice/falcon:keygen",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The reference implementation as a shared object, one per parameter set. The
# only C this repo builds, and it exists because Falcon is gated on an
# implementation rather than on a vector file (../../../../docs/reference/testing.md).
#
# `linkshared` rather than a `cc_test`, because the caller is Python: the oracle
# is reached through `ctypes`, which is what lets the same test hold this repo's
# `verify` and the reference's `crypto_sign` in one process and compare them
# directly.
#
# `no-remote` for the reason the archive's own build file records at length: the
# auto-detected C++ toolchain declares the configuring machine's builtin include
# directories, not the Buildbarn workers'.
[
    cc_binary(
        name = "libfalcon%d_oracle.so" % degree,
        testonly = True,
        srcs = ["falcon_oracle.c"],
        linkshared = True,
        tags = ["no-remote"],
        deps = ["@falcon_round3//:falcon%d" % degree],
    )
    for degree in [
        512,
        1024,
    ]
]

# The `ctypes` binding. Separate from the test because the shared objects are
# its `data` — a test that grew a second oracle case would otherwise re-declare
# them.
py_library(
    name = "falcon_oracle",
    testonly = True,
    srcs = [
        "__init__.py",
        "falcon_oracle.py",
    ],
    data = [
        ":libfalcon1024_oracle.so",
        ":libfalcon512_oracle.so",
    ],
    deps = [
        ":falcon_reference",
        "//sig_frx/lattice/falcon",
        "//sig_frx/lattice/falcon:encoding",
    ],
)

# One `Falcon-512` key generation dominates this target; everything after it —
# a handful of reference signatures and the verdicts `verify` returns on them —
# is seconds. That is the same shape as `falcon_test`, which is `large` for it.
#
# The GPU leg measures **118.0 s on CI** — a workstation read 114.1 s, so the
# 1.03x ratio is the one ../../../../docs/reference/measurement.md records for
# this family. That alone would argue for `medium`, at 39% of its 300 s.
#
# `large` because the CPU leg is the one that has not reported. It reads 65.5 s
# on a workstation, and its executor runs 1.6-3.4x that, which puts it anywhere
# up to about 220 s — 74% of `medium`, past the half-a-budget rule, and the
# deciding leg if it lands there. `large` covers the worse reading at 25% and
# needs no second guess about which leg decides. Narrow it once the CPU leg has
# recorded a figure of its own.
py_test(
    name = "falcon_interop_test",
    size = "large",
    srcs = ["falcon_interop_test.py"],
    deps = [
        ":falcon_oracle",
        ":falcon_vectors",
        "//sig_frx/lattice/falcon",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The archive's per-call sampler traces, parsed. `data` reaches the same
# `falcon_round3` archive the interop oracle compiles, so the sampler and the
# oracle are pinned by one sha256.
py_library(
    name = "sampler_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "sampler_vectors.py",
    ],
    data = ["@falcon_round3//:sampler_vectors"],
    deps = ["@rules_python//python/runfiles"],
)

# Pure host arithmetic over the published traces: parsing two files and running
# 3 072 sampler calls. Not a traced target, so neither leg compiles anything,
# which is why the two are within a second of each other rather than the usual
# multiple — 2.0 s on the CPU leg against 0.9 s on the GPU one, both from CI.
# `small` covers the deciding leg at 3% of its 60 s.
py_test(
    name = "sampler_test",
    size = "small",
    srcs = ["sampler_test.py"],
    deps = [
        ":sampler_vectors",
        "//sig_frx/lattice/falcon:sampler",
        requirement("absl_py"),
    ],
)

# The walk is host `complex128` and the 3 072 sampler calls under it are host
# integers, so like `:sampler_test` this compiles nothing on either leg. From
# CI: 2.8 s on the CPU leg, 1.2 s on the GPU one, of which 0.17 s is the cases
# themselves — the rest is interpreter start and imports, which is why the two
# legs sit within a couple of seconds instead of the multiple every traced
# target here shows. `small` covers the deciding leg at 5% of its 60 s.
py_test(
    name = "sign_test",
    size = "small",
    srcs = ["sign_test.py"],
    deps = [
        ":falcon_reference",
        ":sampler_vectors",
        "//sig_frx/lattice/falcon:arith",
        "//sig_frx/lattice/falcon:fft",
        "//sig_frx/lattice/falcon:keygen",
        "//sig_frx/lattice/falcon:sampler",
        "//sig_frx/lattice/falcon:sign",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
