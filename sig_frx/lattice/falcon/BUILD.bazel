load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The complex FFT over `Q[x]/(x^n + 1)`, which is keygen and signing's transform
# the way `arith` is verification's. Reached through the array namespace's own
# `fft`, so it depends on `//sig_frx:arrays` to read that namespace off its
# arguments rather than naming one.
py_library(
    name = "fft",
    srcs = [
        "__init__.py",
        "fft.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Integers wider than a lane, for key generation's NTRU solver. Depends on no
# scheme — not even on `:arith`, since it names no modulus of Falcon's — so it
# is gated against Python `int` alone, before any of the recursion above it
# exists. No `//sig_frx:arrays`: the module is traced-only on purpose, because
# the host already has arbitrary-precision integers and a host spelling of this
# would be a slower `int`.
py_library(
    name = "bigint",
    srcs = [
        "__init__.py",
        "bigint.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

# §3.8.2's tower-of-fields descent, over `:bigint`. Named for the operation it
# will become rather than for the descent alone: the base case, the lift and
# Babai's reduction land here too. Depends on no hash and on no seam yet — the
# recursion is gated against Python integers, which is the only oracle a step
# inside key generation has.
py_library(
    name = "keygen",
    srcs = [
        "__init__.py",
        "keygen.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        ":bigint",
        ":fft",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# `Z_q` arithmetic and the NTT over q = 12289. Depends on no hash and on no
# scheme logic: the transform is testable against exact integer arithmetic
# before any of keygen, sign or verify exists, which is why it lands on its own.
# frx is a dependency because the transform is its `lax.ntt` opcode.
py_library(
    name = "arith",
    srcs = [
        "__init__.py",
        "arith.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# §3.11's wire formats. Depends on `:arith` for the modulus the 14-bit public
# key width is derived from, and on nothing else — no hash, no scheme logic —
# so the decoder and its rejections are gated before verification exists.
py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# §3.10 — verification, over the two libraries above. Named for the scheme
# rather than for the operation: it carries `FalconParams`, `PARAMETER_SETS`,
# the seam class and `named`, so #26 and #27 add bodies here rather than a
# `sign.py` that would have to import the checking operation. The `Signature` seam and
# the shared context rule are the only dependencies that are not Falcon's own;
# `HashToPoint` reaches its SHAKE through `//sig_frx:hashes` rather than by
# naming a sponge, so no hash-frx dependency appears here beyond the rate
# constant its budget is counted in.
py_library(
    name = "falcon",
    srcs = [
        "__init__.py",
        "falcon.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        ":encoding",
        ":keygen",
        ":sign",
        "//sig_frx:batch",
        "//sig_frx:context",
        "//sig_frx:hashes",
        "//sig_frx:signature",
        "//sig_frx/lattice:rejection",
        "@hash_frx//hash_frx",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# §4.4's discrete Gaussian sampler — Algorithms 12 to 15, which signing rounds
# each coordinate of the lattice point with.
#
# Depends on nothing, not even `//sig_frx:arrays`, and that is the design rather
# than an omission: the rejection loop's trip count is secret-dependent, so it
# has no traced form here (see the module docstring and
# ../../../docs/reference/security.md). Host `float` and `int` are the whole of
# it, which also means it is gated against the published traces before any of
# the tree walk above it exists.
py_library(
    name = "sampler",
    srcs = [
        "__init__.py",
        "sampler.py",
    ],
    visibility = ["//visibility:public"],
)

# Algorithm 11's fast Fourier sampler — the tree walk signing draws its lattice
# point with. Host code following `:sampler`, which it calls at every leaf.
py_library(
    name = "sign",
    srcs = [
        "__init__.py",
        "sign.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fft",
        ":keygen",
        ":sampler",
        requirement("numpy"),
    ],
)
