load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# FIPS 204's algorithms looping the way the standard writes them, over Python
# integers. It is the gate for the reshaped forms until the known-answer tests
# land: no vector file is involved, so this is a transcription rather than a
# fetch, and it depends on nothing outside the standard library — the sampling
# half squeezes `hashlib`'s SHAKE — so a disagreement is never the reference's
# fault.
py_library(
    name = "fips204_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "fips204_reference.py",
    ],
)

py_test(
    name = "arith_test",
    size = "medium",
    srcs = ["arith_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx/lattice/mldsa:arith",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sampling_test",
    size = "medium",
    srcs = ["sampling_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx/lattice/mldsa:arith",
        "//sig_frx/lattice/mldsa:sampling",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
