load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# FIPS 204's algorithms looping the way the standard writes them, over Python
# integers. It is the gate for the reshaped forms until the known-answer tests
# land: no vector file is involved, so this is a transcription rather than a
# fetch, and it depends on nothing outside the standard library — the sampling
# half squeezes `hashlib`'s SHAKE — so a disagreement is never the reference's
# fault.
py_library(
    name = "fips204_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "fips204_reference.py",
    ],
)

py_test(
    name = "arith_test",
    size = "medium",
    srcs = ["arith_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx/lattice/mldsa:arith",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx/lattice/mldsa:arith",
        "//sig_frx/lattice/mldsa:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The scheme against Algorithms 6, 7 and 8 as the standard writes them. Slower
# than its siblings by the shape of what it drives — key generation and signing
# are the concrete path, so every case pays eager dispatch rather than one
# compile.
#
# `large` for the backend it is slowest on rather than for what it does on CPU: a
# per-operation dispatch is what a GPU is worst at, and the size a target carries
# has to cover the slowest leg it runs on.
py_test(
    name = "ml_dsa_test",
    size = "large",
    srcs = ["ml_dsa_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx:context",
        "//sig_frx:prehash",
        "//sig_frx:signature",
        "//sig_frx/lattice/mldsa:ml_dsa",
        "//sig_frx/lattice/mldsa:sampling",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Vectors are fetched and sha256-pinned in //MODULE.bazel rather than committed.
py_library(
    name = "ml_dsa_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "ml_dsa_vectors.py",
    ],
    data = [
        "@acvp_ml_dsa_keygen_expected//file",
        "@acvp_ml_dsa_keygen_prompt//file",
        "@acvp_ml_dsa_siggen_expected//file",
        "@acvp_ml_dsa_siggen_prompt//file",
        "@acvp_ml_dsa_sigver_expected//file",
        "@acvp_ml_dsa_sigver_prompt//file",
    ],
    deps = [
        "//sig_frx:prehash",
        "//sig_frx:signature",
        "//sig_frx/lattice/mldsa:arith",
        "//sig_frx/lattice/mldsa:encoding",
        "//sig_frx/lattice/mldsa:ml_dsa",
        "//sig_frx/lattice/mldsa:sampling",
        "//sig_frx/testing:kat",
        "//sig_frx/testing:vector_sets",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

# The gate on published bytes: reproducing what NIST published is what confirms
# every reading the modules beneath ML-DSA were written from. Key generation runs
# at all three parameter sets and signing at ML-DSA-44, so a review waits on
# Table 1's smallest `A`; `ml_dsa_sweep_test` is the exhaustive run.
py_test(
    name = "ml_dsa_kat_test",
    # `large` for the backend it is slowest on rather than for what it does on
    # CPU, the same reason `ml_dsa_test` carries it: signing is the concrete
    # path, and the size a target carries has to cover the slowest leg it runs
    # on.
    #
    # It once carried `eternal` on top, for 1343 s on the GPU leg against 56 s on
    # CPU — 24x, where every other target on that leg lands at 2.7-3.8x. The
    # cause was per-shape compilation, and not the per-operation dispatch this
    # comment used to guess at: execution is ~0.04% of that number and is
    # *faster* on the leg that routes hash-frx's whole-hash Keccak marker, since
    # the hash becomes one dispatch. What the marker costs instead is tracing its
    # decomposition — the entire absorb and squeeze, unrolled per distinct
    # message shape and in proportion to the block count. ACVP draws a fresh
    # length per case, so the published set is nearly all singletons.
    #
    # `ml_dsa_kat_test.py` bounds the vectors per operation for that reason,
    # which is what brings this back under `large`'s 900 s ceiling: 484 s on the
    # GPU leg against 100 s on CPU, from 1437 s and 167 s. That is 4.8x rather
    # than 24x, and 2.1x the slowest sibling on the leg rather than 7.7x.
    #
    # The leg has since crept to 521-571 s, which is 63% of `large`'s 900 s and
    # over the half-a-budget threshold — so the deadline moves to `eternal`
    # while `size` stays `large`. `size = "enormous"` would buy the same
    # deadline and also raise the target's local resource estimate, which the
    # GPU leg schedules against; this target needs the time, not the weight.
    #
    # The GPU leg agrees with itself to within 1.1x run over run, so the number
    # above is not a contention artefact. That stability is a property of a
    # quiet box rather than of the leg — one GPU runner serves the org — which
    # is why the threshold is the same one the CPU leg gets.
    size = "large",
    timeout = "eternal",
    srcs = ["ml_dsa_kat_test.py"],
    deps = [
        ":ml_dsa_vectors",
        "//sig_frx:prehash",
        "//sig_frx/lattice/mldsa:ml_dsa",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The exhaustive run: all three parameter sets, every published operation.
#
# Unsharded, which is the opposite of what `slh_dsa_sweep_test` needs and worth
# saying why. Its cases are minutes each, so dividing them buys nearly all of the
# wall-clock back; these are seconds each on top of a fixed cost that is not — the
# frx import plus parsing 10 MB of prompts and expected results, which every shard
# pays in full. Measured: 108 s undivided, against 16 shards of 44 s each, so the
# division turns 108 s of work into 707 s of it to halve the wall clock. The
# per-operation cases stay, because that is what names the operation in a failure
# and what lets shards be added if a set ever grows enough to want them.
py_test(
    name = "ml_dsa_sweep_test",
    size = "large",
    srcs = ["ml_dsa_sweep_test.py"],
    tags = ["slow_kat"],
    deps = [
        ":ml_dsa_vectors",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sampling_test",
    size = "medium",
    srcs = ["sampling_test.py"],
    deps = [
        ":fips204_reference",
        "//sig_frx/lattice/mldsa:arith",
        "//sig_frx/lattice/mldsa:sampling",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# Where the concrete path spends its time, and what the sponge choice is worth.
# Run it before optimizing anything on that path. Signing is a host `while` over
# stages that each hash, so the question is per-call cost times per-signature
# call count — and both halves are measured rather than argued.
#
# A `py_binary` and not a test: it asserts nothing, and the numbers belong on the
# issue that acts on them. Committed so a re-measurement compares against the
# same harness rather than a fresh one, which is why `verify_bench` is committed.
py_binary(
    name = "sign_bench",
    testonly = True,
    srcs = ["sign_bench.py"],
    deps = [
        "//sig_frx/lattice/mldsa:arith",
        "//sig_frx/lattice/mldsa:encoding",
        "//sig_frx/lattice/mldsa:ml_dsa",
        "//sig_frx/lattice/mldsa:sampling",
        "@hash_frx//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
