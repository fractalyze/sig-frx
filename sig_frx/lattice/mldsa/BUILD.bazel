load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# `Z_q` arithmetic and the NTT over q = 8380417. Depends on no hash and on no
# scheme logic: FIPS 204's rounding functions and its transform are testable
# against the standard before any of keygen, sign or verify exists, which is why
# they land on their own. frx is a dependency because the transform is its
# `lax.ntt` opcode, and because the same code runs concretely on the signing path
# and under a tracer on the verification one.
py_library(
    name = "arith",
    srcs = [
        "__init__.py",
        "arith.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("zk_dtypes"),
        requirement("numpy"),
    ],
)

# FIPS 204 §7.3's pseudorandom sampling. The keccak dependency is the whole of
# it — every sampler is a SHAKE squeezed to a fixed length and rejection-sampled
# — and `:arith` supplies the field and the modulus the accepted candidates land
# in. No scheme logic above it, so the samplers are gated against the standard
# before keygen, sign or verify exists.
# FIPS 204 §7.1-7.2's wire formats. No cryptography in it — bit manipulation
# over byte strings — but it is traced anyway, because `pkDecode` and
# `sigDecode` run on a verifier's untrusted input and verification is the batch
# path. `HintBitUnpack`'s rejection rides out as a flag rather than a raise for
# the same reason.
py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "sampling",
    srcs = [
        "__init__.py",
        "sampling.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        ":encoding",
        "//sig_frx:arrays",
        "@hash_frx//hash_frx/keccak",
        requirement("frx"),
        requirement("numpy"),
    ],
)
