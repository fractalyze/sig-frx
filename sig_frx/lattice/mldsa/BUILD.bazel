load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# `Z_q` arithmetic and the NTT over q = 8380417. Depends on no hash and on no
# scheme logic: FIPS 204's rounding functions and its transform are testable
# against the standard before any of keygen, sign or verify exists, which is why
# they land on their own. frx is a dependency because the transform is its
# `lax.ntt` opcode, and because the same code runs concretely on the signing path
# and under a tracer on the verification one.
py_library(
    name = "arith",
    srcs = [
        "__init__.py",
        "arith.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("zk_dtypes"),
        requirement("numpy"),
    ],
)

# FIPS 204 §7.1-7.2's conversions and wire formats. Depends on `:arith` for the
# modulus the widths are derived from and on nothing else — no hash, no sampler
# — which is what lets `:sampling` depend on *it* for §7.1 without a cycle.
py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# FIPS 204 §5 and §6 — the scheme itself, over the three libraries above. The
# `Signature` seam and the shared context framing are the only dependencies that
# are not ML-DSA's own: everything else the assembly needs is `:arith`,
# `:encoding` and `:sampling`, and the hash it reaches for directly is `H`.
py_library(
    name = "ml_dsa",
    srcs = [
        "__init__.py",
        "ml_dsa.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        ":encoding",
        ":sampling",
        "//sig_frx:arrays",
        "//sig_frx:context",
        "//sig_frx:prehash",
        "//sig_frx:signature",
        "@hash_frx//hash_frx/keccak",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# FIPS 204 §7.3's pseudorandom sampling. The keccak dependency is the whole of
# it — every sampler is a SHAKE squeezed to a fixed length and rejection-sampled
# — and `:arith` supplies the field and the modulus the accepted candidates land
# in. No scheme logic above it, so the samplers are gated against the standard
# before keygen, sign or verify exists.
py_library(
    name = "sampling",
    srcs = [
        "__init__.py",
        "sampling.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":arith",
        ":encoding",
        "//sig_frx:arrays",
        "@hash_frx//hash_frx/keccak",
        requirement("frx"),
        requirement("numpy"),
    ],
)
