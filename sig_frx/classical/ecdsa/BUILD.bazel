load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# RFC 6979 nonce generation: bytes-and-integers work on the signing path,
# which runs concretely, so it depends on nothing but the standard library.
py_library(
    name = "rfc6979",
    srcs = [
        "__init__.py",
        "rfc6979.py",
    ],
    visibility = ["//visibility:public"],
)

# The chain-agnostic ECDSA core on the Signature seam. The hash arrives
# injected (a MessageHash), so no hash-frx dependency appears here — which
# implementation a call gets is the namespace's business, through
# //sig_frx:hashes.
py_library(
    name = "core",
    srcs = [
        "__init__.py",
        "core.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":rfc6979",
        "//sig_frx:arrays",
        "//sig_frx:context",
        "//sig_frx:hashes",
        "//sig_frx:signature",
        "//sig_frx/classical:group",
        "//sig_frx/classical:weierstrass",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Bitcoin's conventions over the chain-agnostic core — the strict-DER codec,
# the key codecs, and the BIP-62 policy. Like :ethereum below, it names its
# chain freely and the dependency is one-way.
py_library(
    name = "bitcoin",
    srcs = [
        "__init__.py",
        "bitcoin.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        "//sig_frx:hashes",
        "//sig_frx/classical:group",
        "//sig_frx/classical:weierstrass",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Ethereum's conventions over the chain-agnostic core — the one module in the
# family allowed to name the chain. The dependency is one-way: the core never
# imports back.
py_library(
    name = "ethereum",
    srcs = [
        "__init__.py",
        "ethereum.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        "//sig_frx:hashes",
        "//sig_frx/classical:weierstrass",
        requirement("frx"),
        requirement("numpy"),
    ],
)
