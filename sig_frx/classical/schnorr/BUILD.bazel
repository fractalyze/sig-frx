load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# BIP-340 Schnorr — a scheme of its own over the shared Weierstrass
# substrate. The curve is fixed rather than injected: the standard names
# secp256k1, its tagged-hash strings, and the even-y convention together.
py_library(
    name = "bip340",
    srcs = [
        "__init__.py",
        "bip340.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:batch",
        "//sig_frx:context",
        "//sig_frx:signature",
        "//sig_frx/classical:group",
        "//sig_frx/classical:secp",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# MuSig2 over BIP-340's substrate — the tagged-hash construction, the curve
# and the even-y convention are `bip340`'s. Not on the seam: a two-round
# interactive protocol has no seam-shaped `sign`, and its output is a BIP-340
# signature, so it adds no verifier of its own.
py_library(
    name = "musig2",
    srcs = [
        "__init__.py",
        "musig2.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":bip340",
        "//sig_frx/classical:secp",
        requirement("numpy"),
    ],
)
