# The substrate reads its namespace off its arguments, so the same call is a
# host or a device computation. Every KAT runs one of them; this runs both and
# holds them against each other.
#
# `large` from the CPU leg's worst run: 98.4 s, 119.9 s and 193.0 s across three
# post-#226 executions, against `medium`'s 300 s — the worst is 64% of it, and
# the spread over content that does not touch this test is 1.96x, which is the
# CPU leg's documented variance rather than anything about the change. The GPU
# leg runs the same target in 32.3-51.5 s, so CPU is the slowest leg and the one
# the budget covers, per ../../../docs/reference/measurement.md.
#
# It costs what it does because it forces the placement threshold rather than
# reaching it, so every shape it touches pays a compile — #226's fused ladder is
# what made that expensive. Those forced shapes are the coverage (see the test's
# own note on why), so the bucket moves rather than the test shrinking.
py_test(
    name = "secp_device_test",
    size = "large",
    srcs = ["secp_device_test.py"],
    deps = [
        ":ecdsa_wycheproof_vectors",
        "//sig_frx:arrays",
        "//sig_frx/classical:secp",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

