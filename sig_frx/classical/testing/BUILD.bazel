    data = ["@cctv_ed25519_vectors//file"],
    deps = [
        "//sig_frx:signature",
        "//sig_frx/classical/eddsa:consensus",
        "//sig_frx/classical/eddsa:ed25519",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

