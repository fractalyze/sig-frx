load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# SEC 1 §2.2.1's addition rule looping the way the standard writes it, over
# Python integers. No vector file is involved — the group law's standard
# publishes cases, not vectors — so this is a transcription, and it depends on
# nothing outside the standard library.
py_library(
    name = "sec1_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "sec1_reference.py",
    ],
)

# The affine twisted-Edwards rule, same role for the Edwards substrate.
py_library(
    name = "edwards_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "edwards_reference.py",
    ],
)

py_test(
    name = "eddsa_test",
    size = "medium",
    srcs = ["eddsa_test.py"],
    deps = [
        ":edwards_reference",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical:group",
        "//sig_frx/classical/eddsa:ed25519",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# One marker shared by every traced classical case, so the skip and its
# reasons live in a single module rather than a copy per test file.
py_library(
    name = "traced_blocker",
    testonly = True,
    srcs = [
        "__init__.py",
        "traced_blocker.py",
    ],
    deps = [
        "//sig_frx/classical:weierstrass",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "weierstrass_test",
    size = "medium",
    srcs = ["weierstrass_test.py"],
    deps = [
        ":sec1_reference",
        ":traced_blocker",
        "//sig_frx/classical:group",
        "//sig_frx/classical:weierstrass",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "rfc6979_test",
    size = "small",
    srcs = ["rfc6979_test.py"],
    deps = [
        "//sig_frx/classical/ecdsa:rfc6979",
        requirement("absl_py"),
    ],
)

# The Wycheproof loading and the encoding-boundary split, shared by the
# per-PR slice and the scheduled sweep so the two cannot disagree about what
# "runnable" means.
py_library(
    name = "ecdsa_wycheproof_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "ecdsa_wycheproof_vectors.py",
    ],
    data = [
        "@wycheproof_ecdsa_secp256k1_p1363//file",
        "@wycheproof_ecdsa_secp256r1_p1363//file",
    ],
    deps = [
        "//sig_frx/classical:weierstrass",
        "//sig_frx/classical/ecdsa:core",
        "//sig_frx/testing:kat",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "ecdsa_wycheproof_test",
    size = "medium",
    srcs = ["ecdsa_wycheproof_test.py"],
    deps = [
        ":ecdsa_wycheproof_vectors",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "ecdsa_wycheproof_sweep_test",
    size = "large",
    srcs = ["ecdsa_wycheproof_sweep_test.py"],
    tags = ["slow_kat"],
    deps = [
        ":ecdsa_wycheproof_vectors",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "ecdsa_test",
    size = "medium",
    srcs = ["ecdsa_test.py"],
    deps = [
        ":traced_blocker",
        "//sig_frx/classical:group",
        "//sig_frx/classical:weierstrass",
        "//sig_frx/classical/ecdsa:core",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
