load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# SEC 1 §2.2.1's addition rule looping the way the standard writes it, over
# Python integers. No vector file is involved — the group law's standard
# publishes cases, not vectors — so this is a transcription, and it depends on
# nothing outside the standard library.
py_library(
    name = "sec1_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "sec1_reference.py",
    ],
)

py_test(
    name = "weierstrass_test",
    size = "medium",
    srcs = ["weierstrass_test.py"],
    deps = [
        ":sec1_reference",
        "//sig_frx/classical:weierstrass",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
