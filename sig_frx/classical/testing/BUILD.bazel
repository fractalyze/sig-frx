# Where classical verification spends its time, per lane, split at the substrate
# seams. A dev tool rather than a test — it asserts nothing beyond its own
# fixtures, and the numbers belong on the issue that acts on them — but it is
# committed so a re-measurement after a substrate change compares against the
# same harness rather than a fresh one.
py_binary(
    name = "verify_bench",
    testonly = True,
    srcs = ["verify_bench.py"],
    deps = [
        "//sig_frx:hashes",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical:group",
        "//sig_frx/classical:secp",
        "//sig_frx/classical/ecdsa:core",
        "//sig_frx/classical/eddsa:consensus",
        "//sig_frx/classical/eddsa:ed25519",
        "//sig_frx/classical/schnorr:bip340",
        "//sig_frx/threshold:frost",
        "//sig_frx/threshold:secp256k1_sha256",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium`, decided by the CPU leg: 51.7 s against 9.1 s on the GPU leg. That is
# 86% of `small`'s 60 s, well past the half-budget rule in
# ../../../docs/reference/measurement.md, and the next run of unchanged content
# spent the remaining 14% and timed out. 51.7 s is 17% of `medium`'s 300 s.
#
# Two local runs of this target read 2.5x apart from each other, which is why
# neither sized it — the CPU leg is the one that decides.
py_test(
    name = "musig2_test",
    size = "medium",
    srcs = ["musig2_test.py"],
    data = [
        "@bip327_det_sign_vectors//file",
        "@bip327_key_agg_vectors//file",
        "@bip327_key_sort_vectors//file",
        "@bip327_nonce_agg_vectors//file",
        "@bip327_nonce_gen_vectors//file",
        "@bip327_sig_agg_vectors//file",
        "@bip327_sign_verify_vectors//file",
        "@bip327_tweak_vectors//file",
    ],
    deps = [
        "//sig_frx/classical:secp",
        "//sig_frx/classical/schnorr:bip340",
        "//sig_frx/classical/schnorr:musig2",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)
