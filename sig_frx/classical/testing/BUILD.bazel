load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The affine twisted-Edwards rule, same role for the Edwards substrate.
py_library(
    name = "edwards_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "edwards_reference.py",
    ],
)

py_test(
    name = "eddsa_test",
    size = "medium",
    srcs = ["eddsa_test.py"],
    deps = [
        ":edwards_reference",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical/eddsa:ed25519",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The C2SP interoperability set and the accept set each construction claims.
# A library rather than test-local data: the predicates are the statement of
# what each rule is, and they are read by the test that runs them.
py_library(
    name = "ed25519_cctv_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "ed25519_cctv_vectors.py",
