load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# Ed25519 over the Edwards substrate. SHA-512 is reached through hashlib on
# the concrete paths — hash-frx ships none — which the module records as a
# decision, not an accident.
py_library(
    name = "ed25519",
    srcs = [
        "__init__.py",
        "ed25519.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        "//sig_frx:batch",
        "//sig_frx:context",
        "//sig_frx:signature",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical:group",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The consensus-relevant verification rules as named constructions, plus the
# aggregate check only the cofactored one can offer. Verify only: signing is
# RFC 8032's and shared, so this rides on `:ed25519` rather than beside it.
py_library(
    name = "consensus",
    srcs = [
        "__init__.py",
        "consensus.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ed25519",
        "//sig_frx:signature",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical:group",
        requirement("frx"),
        requirement("numpy"),
    ],
)
