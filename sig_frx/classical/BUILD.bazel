load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The encoding-side plumbing left after both substrates moved onto curated
# zk_dtypes point types: the constant-exponent field power both square-root
# recoveries run on, plus the bytewise range compare and weighted byte sum
# that only the Edwards encodings call today.
py_library(
    name = "group",
    srcs = [
        "__init__.py",
        "group.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The SEC curves over curated zk_dtypes point dtypes: the curve constants,
# the parity-selected square-root lift, and the byte/int codecs — everything
# the dtypes' fused kernels do not expose. The codecs are host-path; the dtype
# ufuncs follow the namespace their arguments arrive in. The GPU story is EC
# kernels over the same dtypes (fractalyze/sig-frx#139).
py_library(
    name = "secp",
    srcs = [
        "__init__.py",
        "secp.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The twisted-Edwards sibling: the same substrate contract over the curated
# ed25519 point dtypes, RFC 8032's decoding and encodings, and the one
# deliberate storage read (the sign bit) that makes canonical-storage fields
# a requirement rather than a preference.
py_library(
    name = "edwards",
    srcs = [
        "__init__.py",
        "edwards.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
