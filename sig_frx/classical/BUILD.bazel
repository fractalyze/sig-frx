load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The short-Weierstrass curve substrate: fields minted from the curve moduli,
# the complete projective group law, and the fixed-shape scalar ladder. Depends
# on no hash and no scheme logic — the group law is testable against SEC 1
# before any of keygen, sign or verify exists. frx is a dependency because the
# ladder's loop is `lax.fori_loop` under a tracer, and because the same
# formulas run concretely on the signing path and traced on verification.
# The curve-family-agnostic plumbing both substrates share: byte/bit
# reshapes, the bytewise range compare, the fixed-shape ladder, and the host
# readback. Split out when the Edwards substrate arrived as the second
# consumer.
py_library(
    name = "group",
    srcs = [
        "__init__.py",
        "group.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "weierstrass",
    srcs = [
        "__init__.py",
        "weierstrass.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The twisted-Edwards sibling: the same substrate contract, RFC 8032's own
# formulas, and the one deliberate storage read (the sign bit) that makes
# canonical-storage fields a requirement rather than a preference.
py_library(
    name = "edwards",
    srcs = [
        "__init__.py",
        "edwards.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
