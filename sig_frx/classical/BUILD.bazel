load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The Edwards substrate's plumbing: byte/bit reshapes, the bytewise range
# compare, the fixed-shape ladder, and the host readback. Once shared with a
# hand-rolled Weierstrass substrate; the SEC curves now ride curated zk_dtypes
# point types (:secp), which keep only `pow_const` from here.
py_library(
    name = "group",
    srcs = [
        "__init__.py",
        "group.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The SEC curves over curated zk_dtypes point dtypes: the curve constants,
# the parity-selected square-root lift, and the byte/int codecs — everything
# the dtypes' fused kernels do not expose. Host-path throughout; the GPU
# story is EC kernels over the same dtypes (fractalyze/sig-frx#139).
py_library(
    name = "secp",
    srcs = [
        "__init__.py",
        "secp.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The twisted-Edwards sibling: the same substrate contract, RFC 8032's own
# formulas, and the one deliberate storage read (the sign bit) that makes
# canonical-storage fields a requirement rather than a preference.
py_library(
    name = "edwards",
    srcs = [
        "__init__.py",
        "edwards.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":group",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
