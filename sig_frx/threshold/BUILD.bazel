load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# The prime-order group a threshold protocol runs over, as one Protocol.
# Names no protocol, so a second scheme over these curves depends on this
# rather than on frost. Typing only — no runtime dependency of its own.
py_library(
    name = "group",
    srcs = [
        "__init__.py",
        "group.py",
    ],
    visibility = ["//visibility:public"],
)

# The RFC 9591 skeleton: round functions, aggregation, share verification,
# and the trusted-dealer sharing, all ciphersuite-parameterized and all pure.
# Standard library only — the group arrives through the Ciphersuite, which is
# the group Protocol plus §6's five hashes.
py_library(
    name = "frost",
    srcs = [
        "__init__.py",
        "frost.py",
    ],
    visibility = ["//visibility:public"],
    deps = [":group"],
)

# FROST(Ed25519, SHA-512): §6.1's constants and hashes over the Edwards
# substrate the Ed25519 scheme already uses.
py_library(
    name = "ed25519_sha512",
    srcs = [
        "__init__.py",
        "ed25519_sha512.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":frost",
        "//sig_frx/classical:edwards",
        "//sig_frx/classical/eddsa:ed25519",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# expand_message_xmd (RFC 9380 §5.3.1) — the scalar derivation the
# hash-to-field ciphersuites share. Standard library only.
py_library(
    name = "xmd",
    srcs = [
        "__init__.py",
        "xmd.py",
    ],
    visibility = ["//visibility:public"],
)

# secp256k1_XMD:SHA-256_SSWU_RO_ (RFC 9380 §8.7) — the random oracle into the
# group. Depends on secp for the group sum and the readback; the field
# arithmetic is host integers, so nothing else arrives with it.
py_library(
    name = "hash_to_curve",
    srcs = [
        "__init__.py",
        "hash_to_curve.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":xmd",
        "//sig_frx/classical:secp",
        requirement("numpy"),
    ],
)

# Masny-Rindal endemic OT (MR19 Figure 8) over secp256k1 — the base OTs
# DKLs23 §8.1 names. Depends on the oracle into the group and on secp for the
# batched point seams; the expansion and the key derivation are hashlib, which
# is the whole rest of this package's face too.
py_library(
    name = "base_ot",
    srcs = [
        "__init__.py",
        "base_ot.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":hash_to_curve",
        "//sig_frx/classical:secp",
        requirement("numpy"),
    ],
)

# FROST(secp256k1, SHA-256): §6.5's constants over the curated secp substrate.
py_library(
    name = "secp256k1_sha256",
    srcs = [
        "__init__.py",
        "secp256k1_sha256.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":frost",
        ":xmd",
        "//sig_frx/classical:secp",
        requirement("frx"),
        requirement("numpy"),
    ],
)
