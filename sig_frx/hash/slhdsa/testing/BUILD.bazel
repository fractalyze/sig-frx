load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "fors_test",
    size = "small",
    srcs = ["fors_test.py"],
    deps = [
        "//sig_frx/hash:adrs",
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/slhdsa:fors",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium` for the margin rather than the runtime. The work is a few seconds of
# hashing, but this target measures 24.5 s to 57.3 s on the CPU leg across runs
# of unchanged commits — so `small`'s 60 s was decided by executor load rather
# than by the test, and one commit both passed and timed out under it. Sized
# from the worst run on the slowest leg, per
# ../../../../docs/reference/measurement.md.
py_test(
    name = "xmss_test",
    size = "medium",
    srcs = ["xmss_test.py"],
    deps = [
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash:wots",
        "//sig_frx/hash/slhdsa:hypertree",
        "//sig_frx/hash/slhdsa:xmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `large` from the CPU leg's worst run: 114.3 s to 224.9 s across unchanged
# commits, against `medium`'s 300 s. The GPU leg runs it in a steady ~120 s —
# the slowest leg is what a budget covers, per
# ../../../../docs/reference/measurement.md.
py_test(
    name = "slh_dsa_test",
    size = "large",
    srcs = ["slh_dsa_test.py"],
    deps = [
        "//sig_frx:context",
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash:wots",
        "//sig_frx/hash/slhdsa:fors",
        "//sig_frx/hash/slhdsa:hypertree",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "//sig_frx/hash/slhdsa:xmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Where verification spends its time. A dev tool rather than a test — it asserts
# nothing, and the numbers belong on the issue that acts on them — but it is
# committed so a re-measurement after the hash becomes traceable compares against
# the same harness rather than a fresh one.
py_binary(
    name = "verify_bench",
    testonly = True,
    srcs = ["verify_bench.py"],
    deps = [
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/slhdsa:fors",
        "//sig_frx/hash/slhdsa:hypertree",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The published vectors, grouped by operation, plus the seam adapters that let one
# harness drive the interfaces the seam deliberately does not name. Shared by the
# merge gate and the sweep so the two cannot disagree about what is runnable.
# Vectors are fetched and sha256-pinned in //MODULE.bazel rather than committed.
py_library(
    name = "slh_dsa_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "slh_dsa_vectors.py",
    ],
    data = [
        "@acvp_slh_dsa_keygen_expected//file",
        "@acvp_slh_dsa_keygen_prompt//file",
        "@acvp_slh_dsa_siggen_expected//file",
        "@acvp_slh_dsa_siggen_prompt//file",
        "@acvp_slh_dsa_sigver_expected//file",
        "@acvp_slh_dsa_sigver_prompt//file",
    ],
    deps = [
        "//sig_frx:prehash",
        "//sig_frx:signature",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "//sig_frx/testing:kat",
        "//sig_frx/testing:vector_sets",
        "@rules_python//python/runfiles",
    ],
)

# The gate on published bytes: reproducing what NIST published is what confirms
# every reading the components beneath SLH-DSA were written from. The `f`
# parameter set, so a review waits on 8-key-pair trees rather than 512-key-pair
# ones; `slh_dsa_sweep_test` is the exhaustive run.
py_test(
    name = "slh_dsa_kat_test",
    # The longest test in this package. Size it from the executor rather than
    # from a dev workstation: a local run reports roughly twice the headroom CI
    # has.
    #
    # The CPU leg measures 301.7 s to 572.2 s across runs of unchanged commits,
    # so the worst run is over half of `large`'s 900 s. The deadline moves up a
    # bucket and `size` stays `large` — see "`size` moves two things and
    # `timeout` moves one" in ../../../../docs/reference/measurement.md. The GPU
    # leg runs the same target in a steady ~285 s.
    size = "large",
    timeout = "eternal",
    srcs = ["slh_dsa_kat_test.py"],
    deps = [
        ":slh_dsa_vectors",
        "//sig_frx:prehash",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "//sig_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Verification under a tracer. Its own target because the cost is compilation
# rather than hashing: the category 1 sets unroll the whole `d`-layer walk, which
# would be most of `slh_dsa_test`'s runtime and none of what its assembly cases
# check.
#
# `large` for that compile rather than for the work it does. Unrolling 22 layers
# is minutes on the GPU leg against a minute or so on CPU, and the size a target
# carries has to cover the slowest backend it runs on — a compile-bound test that
# fits its budget on one backend and not the other is a timeout waiting for a
# matrix leg to be added.
#
# `eternal` since hash-frx 7e3e7b5f: routing sha256's digest through the
# raw-bytes marker composite (hash-frx#183) roughly doubled this compile
# (measured 2.0x on one box), and the CPU leg shares its runner with
# the KAT suite — `large`'s 900s stopped covering the slowest leg. The compile
# cost itself is an upstream property (fractalyze/hash-frx#197), not this
# test's workload.
#
# It stays `eternal` past the emitter fix for that regression
# (fractalyze/xla#572, on this repo's pin since hash-frx 9d86ae73): the fix cuts
# the compile, but a local compile is not what the budget covers, and on CI at
# that pin this target measures **950.9s**, still over `large`'s 900s. The GPU
# leg runs the same target in 177.7s; the CPU runner's sharing is most of the
# gap, which is why a local figure cannot decide this. Re-check against a CI
# run, not a workstation, before shrinking.
py_test(
    name = "slh_dsa_traced_test",
    size = "large",
    timeout = "eternal",
    srcs = ["slh_dsa_traced_test.py"],
    deps = [
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Every constructible parameter set against every published vector. Tagged
# `slow_kat`, so .bazelrc.ci drops it from a PR run and the scheduled job puts it
# back: it is the standards-exactness gate, and it is too slow to sit in review.
#
# Sharded rather than given a bigger budget, because no budget holds the whole
# sweep for long: it is tens of minutes on a dev workstation, and this package
# measures 2.1-2.7x slower on the CI executor, so an undivided run spends most of
# `enormous`'s hour with four more parameter sets still to become constructible.
# The test cuts at the published operation, the longest of which is under a tenth
# of the whole, and names its cases so that a shard draws the operations of one
# parameter set. At thirty-two the worst shard is 121.6 s — a third of `large`
# once the executor factor is paid — and every shard compiles one set's kernels
# rather than several shards each compiling the same set's.
py_test(
    name = "slh_dsa_sweep_test",
    size = "large",
    srcs = ["slh_dsa_sweep_test.py"],
    shard_count = 32,
    tags = ["slow_kat"],
    deps = [
        ":slh_dsa_vectors",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)
