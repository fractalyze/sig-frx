load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# LeanSig — the generalized XMSS Ethereum's lean consensus signs with. It hashes
# with Poseidon over KoalaBear rather than a byte hash, so what it shares with the
# FIPS 205 and RFC 8391 lines is the tree walk and the chain, not the family.

# One scheme's parameter set, so it sits with the scheme rather than in hash-frx;
# the siting rule and the provenance live in the module. Values only — no frx, no
# hash — so a reader diffing them against the spec pulls in nothing.
py_library(
    name = "poseidon_constants",
    srcs = [
        "__init__.py",
        "poseidon_constants.py",
    ],
    visibility = ["//visibility:public"],
)

# The prime, and the base-p decomposition of the wide host integers the sponge
# capacity and the message hash both pack. Shared by them rather than owned by
# either, the way leanSpec's own `xmss/field.py` is.
py_library(
    name = "field",
    srcs = [
        "__init__.py",
        "field.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The two presets leanSig instantiates: values, two derived quantities, and the
# invariant that ties them together. It reaches `field` for the prime the
# invariant is stated against, so unlike the Poseidon constants above this one is
# not free of the frx runtime.
py_library(
    name = "params",
    srcs = [
        "__init__.py",
        "params.py",
    ],
    visibility = ["//visibility:public"],
    deps = [":field"],
)

# The two permutations those constants parameterize.
py_library(
    name = "poseidon",
    srcs = [
        "__init__.py",
        "poseidon.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":field",
        ":poseidon_constants",
        "@hash_frx//hash_frx",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Message to codeword: the hash, the aborting decode and the target-sum filter.
py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":field",
        ":params",
        ":poseidon",
        "//sig_frx:arrays",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The tweakable hash family — the chain step, the Merkle node and the leaf — plus
# the packed tweaks each is positioned by. It reaches `//sig_frx/hash:tree` for
# the `NodeAddresses` seam it fills rather than for the walk, which its callers
# drive.
py_library(
    name = "tweakable",
    srcs = [
        "__init__.py",
        "tweakable.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":field",
        ":params",
        ":poseidon",
        "//sig_frx/hash:tree",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
