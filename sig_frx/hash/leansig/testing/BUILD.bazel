load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Transcribed constants rather than a fetched file: leanSpec publishes its
# fixtures under a release tag regenerated in place, so there is no commit-pinned
# URL to fetch and the provenance lives in the module. Same shape as
# `rfc8391_vectors`.
py_library(
    name = "poseidon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "poseidon_vectors.py",
    ],
)

# The lane-order conversions and the host/traced pairing all three suites here
# need. Shared rather than restated per suite: the reversal is the convention
# most likely to move, and three copies are three places to find it.
py_library(
    name = "harness",
    testonly = True,
    srcs = [
        "__init__.py",
        "harness.py",
    ],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "field_test",
    size = "small",
    srcs = ["field_test.py"],
    deps = [
        "//sig_frx/hash/leansig:field",
        requirement("absl_py"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "poseidon_test",
    size = "small",
    srcs = ["poseidon_test.py"],
    deps = [
        ":harness",
        ":poseidon_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The compression and sponge modes have no upstream vector file at all — the
# fixtures archive pins the permutation but no scheme-level call — so these came
# from running the reference implementation. The provenance and the recipe for
# reproducing that run live in the module.
py_library(
    name = "mode_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "mode_vectors.py",
    ],
)

# `medium` for the margin rather than the runtime. This measures 41.0 s on the
# CPU leg and 31.2 s on the GPU leg, against 13 s on a workstation — `small`'s
# 60 s is inside that spread, and an earlier revision proved it by timing out
# there and taking the suite red. Nearly all of it is compiling the traced leg.
# Sized from the worst run on the slowest leg, per
# ../../../../docs/reference/measurement.md — re-check against a CI run, not a
# workstation, before shrinking it.
py_test(
    name = "mode_test",
    size = "medium",
    srcs = ["mode_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The message-to-codeword pipeline has no upstream vector file either — the same
# gap `mode_vectors` records — so these came from running the reference
# implementation at the same pin, through the same environment recipe.
py_library(
    name = "encoding_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "encoding_vectors.py",
    ],
)

# `medium` from the start, and the number below is not a CI one yet. This
# measures 5.2 s on a workstation CPU and 10.1 s on its GPU; the sibling
# `mode_test` runs the same shapes at 13 s locally against 41.0 s and 31.2 s on
# the two CI legs, so the executor factors to carry over are about 3.2x and
# 2.4x — putting this near 17 s and 24 s, with the CPU leg's own run-to-run
# spread on top. `small`'s 60 s is inside that, which is exactly how `mode_test`
# went red before its own bump. Replace these with the measured CI numbers after
# the first run, per ../../../../docs/reference/measurement.md — and size from
# the worst run on the slowest leg, never from the workstation.
py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":encoding_vectors",
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:encoding",
        "//sig_frx/hash/leansig:params",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
