load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Transcribed constants rather than a fetched file: leanSpec publishes its
# fixtures under a release tag regenerated in place, so there is no commit-pinned
# URL to fetch and the provenance lives in the module. Same shape as
# `rfc8391_vectors`.
py_library(
    name = "poseidon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "poseidon_vectors.py",
    ],
)

# The lane-order conversions and the host/traced pairing all three suites here
# need. Shared rather than restated per suite: the reversal is the convention
# most likely to move, and three copies are three places to find it.
py_library(
    name = "harness",
    testonly = True,
    srcs = [
        "__init__.py",
        "harness.py",
    ],
    deps = [
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/leansig:params",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# What leanSpec's PRF derives, at both presets. Values only, like the other
# vector libraries here; the provenance lives in the module.
py_library(
    name = "prf_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "prf_vectors.py",
    ],
)

# The key pair and the six signatures one substituted seed produces. It reaches
# `prf_vectors` for that seed rather than restating it, the way
# `encoding_vectors` reaches `mode_vectors` — one value, one home.
py_library(
    name = "signing_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "signing_vectors.py",
    ],
    deps = [":prf_vectors"],
)

# Two SHAKE128 derivations and their refusals. Host-only — there is no traced
# leg to compile, since hashing bytes is not array work — so this is the
# cheapest suite here: 2.9 s on the CPU leg and 3.6 s on the GPU leg, a
# nineteenth of the 60 s budget and well inside the half-a-budget rule in
# ../../../../docs/reference/measurement.md.
py_test(
    name = "prf_test",
    size = "small",
    srcs = ["prf_test.py"],
    deps = [
        ":harness",
        ":prf_vectors",
        "//sig_frx/hash/leansig:prf",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The signer's whole surface: key generation, the sliding window, and six
# signatures byte-compared against upstream. Every case builds a `TEST` key pair
# — 256 slots of 4 chains, then 8 Merkle levels — and each sign case grinds a
# block of randomness on top of that.
#
# `medium`, and the GPU leg is what decides it: 53.4 s there against 48.6 s on
# the CPU leg. That is under `small`'s 60 s budget but at 89% of it, which the
# half-a-budget rule in ../../../../docs/reference/measurement.md is exactly
# about — a target sized that tightly flakes on a loaded executor. At `medium`
# it is a sixth of the 300 s budget. A workstation run reads 20 s and argues for
# `small`; per that page it is right about the local number and the local number
# is not the one that decides.
#
# Both figures are post-cleanup and moved a lot: the suite was generating a
# whole-lifetime key pair per case, which put the CPU leg at 74.3 s.
py_test(
    name = "signing_test",
    size = "medium",
    srcs = ["signing_test.py"],
    deps = [
        ":harness",
        ":signing_vectors",
        "//sig_frx/hash/leansig",
        "//sig_frx/hash/leansig:encoding",
        "//sig_frx/hash/leansig:field",
        "//sig_frx/hash/leansig:params",
        "//sig_frx/hash/leansig:prf",
        "//sig_frx/hash/leansig:signing",
        "//sig_frx/hash/leansig:ssz",
        "//sig_frx/hash/leansig:tweakable",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "field_test",
    size = "small",
    srcs = ["field_test.py"],
    deps = [
        "//sig_frx/hash/leansig:field",
        requirement("absl_py"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "poseidon_test",
    size = "small",
    srcs = ["poseidon_test.py"],
    deps = [
        ":harness",
        ":poseidon_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The compression and sponge modes have no upstream vector file at all — the
# fixtures archive pins the permutation but no scheme-level call — so these came
# from running the reference implementation. The provenance and the recipe for
# reproducing that run live in the module.
py_library(
    name = "mode_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "mode_vectors.py",
    ],
)

# `medium`, decided by the GPU leg: 48.5 s against the CPU leg's 35.6 s, the two
# having swapped order since this was first sized. That is 81% of `small`'s
# 60 s, well past the half-a-budget rule in
# ../../../../docs/reference/measurement.md, and an earlier revision proved it by
# timing out there. Nearly all of it is compiling the traced leg.
py_test(
    name = "mode_test",
    size = "medium",
    srcs = ["mode_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The message-to-codeword pipeline has no upstream vector file either — the same
# gap `mode_vectors` records — so these came from running the reference
# implementation at the same pin, through the same environment recipe.
py_library(
    name = "encoding_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "encoding_vectors.py",
    ],
)

# `small`, decided by the worst CPU run: 20.8 s against 20.1 s on the GPU leg —
# 35% of the 60 s budget, where ../../../../docs/reference/measurement.md moves a
# target up at half. The CPU leg spread 2x across runs of this branch, so **a run
# past 30 s on either leg moves this to `medium`**. It undercuts `mode_test`
# because its traced leg compiles two width-24 compressions rather than a
# 25-chunk sponge.
py_test(
    name = "encoding_test",
    size = "small",
    srcs = ["encoding_test.py"],
    deps = [
        ":encoding_vectors",
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:encoding",
        "//sig_frx/hash/leansig:params",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The family and the Merkle walk have no upstream vector file either, and one of
# the two references is a transcription of upstream's own `verify_path` loop
# because that function returns a bool rather than a root. Both the provenance
# and the round trip that gates the transcription live in the module.
py_library(
    name = "tweakable_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "tweakable_vectors.py",
    ],
)

# `large`, decided by the GPU leg: 75.6 s worst across two CI runs, against
# 52.0 s on the CPU leg. That is 25% of `medium`, but this leg has been measured
# up to 2.3x slower under load, which puts a bad run at ~174 s — 58% of it, past
# the half-a-budget rule in ../../../../docs/reference/measurement.md. The only
# run this target ever had under `medium` agrees, at 152.2 s.
py_test(
    name = "tweakable_test",
    size = "large",
    srcs = ["tweakable_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        ":tweakable_vectors",
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash:wots",
        "//sig_frx/hash/leansig:params",
        "//sig_frx/hash/leansig:tweakable",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The wire format is the one leanSig layer the fixtures archive covers, so these
# are transcribed from a published file rather than produced by a driver — except
# the `TEST` preset, which the archive does not carry. Both provenances, and the
# recipe for the second, live in the module.
py_library(
    name = "ssz_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "ssz_vectors.py",
    ],
)

# `small`: 5.7 s on the CPU leg and 5.8 s on the GPU one, the cheapest target in
# the package because the codec compiles no permutation at all — the whole of it
# is a reshape, a shift and a sum. Even at the 2.3x this GPU leg has been
# measured at under load that is 13 s, a fifth of the 60 s budget, well inside
# the half-a-budget rule in ../../../../docs/reference/measurement.md.
py_test(
    name = "ssz_test",
    size = "small",
    srcs = ["ssz_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        ":ssz_vectors",
        "//sig_frx/hash/leansig:field",
        "//sig_frx/hash/leansig:params",
        "//sig_frx/hash/leansig:ssz",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The vectors the scheme suite gates on: whole `(key, slot, root, signature)`
# objects with upstream's verdict, at `TEST` because signing needs a key.
py_library(
    name = "verify_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "verify_vectors.py",
    ],
    visibility = ["//sig_frx:__subpackages__"],
)

# The assembly: the chain walk, the leaf and the Merkle climb wired to each
# other and to the codec.
#
# `medium` on 12.8 s CPU (local) and 42.7 s GPU (CI run 33079092342, fresh on
# both legs). `small` is what the CPU number alone would have argued for and it
# is wrong: 42.7 s is already 71% of that bucket's 60 s before any load, and this
# leg has been measured moving as a whole by up to 2.33x on a busy runner. The
# GPU leg decides here, which is the case `measurement.md` describes.
#
# Cheaper than this package's own prediction that a verify suite would be its
# most expensive target, and the reason is the preset rather than the work:
# these vectors are `TEST`, where `DIMENSION` is 4 against `PROD`'s 46 and the
# tree is 8 levels against 32. The chain and tree walks that dominate
# `tweakable_test` are compiled here at a fraction of that shape. A `PROD`
# verification case would not be, and `size` moves with the vectors.
py_test(
    name = "leansig_test",
    size = "medium",
    srcs = ["leansig_test.py"],
    deps = [
        ":verify_vectors",
        "//sig_frx/hash/leansig",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
