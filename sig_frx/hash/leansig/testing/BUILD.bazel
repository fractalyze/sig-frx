load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Transcribed constants rather than a fetched file: leanSpec publishes its
# fixtures under a release tag regenerated in place, so there is no commit-pinned
# URL to fetch and the provenance lives in the module. Same shape as
# `rfc8391_vectors`.
py_library(
    name = "poseidon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "poseidon_vectors.py",
    ],
)

py_test(
    name = "poseidon_test",
    size = "small",
    srcs = ["poseidon_test.py"],
    deps = [
        ":poseidon_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The compression and sponge modes have no upstream vector file at all — the
# fixtures archive pins the permutation but no scheme-level call — so these came
# from running the reference implementation. The provenance and the recipe for
# reproducing that run live in the module.
py_library(
    name = "mode_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "mode_vectors.py",
    ],
)

# `medium` for the margin rather than the runtime. This measures 73.9 s on the
# CPU leg and 50.4 s on the GPU leg, against 22 s on a workstation — a 3.4x
# executor factor, and `small`'s 60 s sat inside it, so the first CI run timed
# out and took the suite red. Most of the cost is compiling the traced leg, where
# the `PROD_CONFIG` leaf dominates: 25 absorb chunks unroll to 25 width-24
# permutations in one graph. Sized from the worst run on the slowest leg, per
# ../../../../docs/reference/measurement.md — re-check against a CI run, not a
# workstation, before shrinking it.
py_test(
    name = "mode_test",
    size = "medium",
    srcs = ["mode_test.py"],
    deps = [
        ":mode_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
