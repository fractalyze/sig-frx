load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Transcribed constants rather than a fetched file: leanSpec publishes its
# fixtures under a release tag regenerated in place, so there is no commit-pinned
# URL to fetch and the provenance lives in the module. Same shape as
# `rfc8391_vectors`.
py_library(
    name = "poseidon_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "poseidon_vectors.py",
    ],
)

# The lane-order conversions and the host/traced pairing all three suites here
# need. Shared rather than restated per suite: the reversal is the convention
# most likely to move, and three copies are three places to find it.
py_library(
    name = "harness",
    testonly = True,
    srcs = [
        "__init__.py",
        "harness.py",
    ],
    deps = [
        "//sig_frx/hash/leansig:params",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "field_test",
    size = "small",
    srcs = ["field_test.py"],
    deps = [
        "//sig_frx/hash/leansig:field",
        requirement("absl_py"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "poseidon_test",
    size = "small",
    srcs = ["poseidon_test.py"],
    deps = [
        ":harness",
        ":poseidon_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The compression and sponge modes have no upstream vector file at all — the
# fixtures archive pins the permutation but no scheme-level call — so these came
# from running the reference implementation. The provenance and the recipe for
# reproducing that run live in the module.
py_library(
    name = "mode_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "mode_vectors.py",
    ],
)

# `medium` for the margin rather than the runtime. This measures 41.0 s on the
# CPU leg and 31.2 s on the GPU leg, and a workstation reads 0.32x the CPU leg
# — `small`'s 60 s is inside that spread, and an earlier revision proved it by
# timing out there and taking the suite red. Nearly all of it is compiling the
# traced leg.
# Sized from the worst run on the slowest leg, per
# ../../../../docs/reference/measurement.md — re-check against a CI run, not a
# workstation, before shrinking it.
py_test(
    name = "mode_test",
    size = "medium",
    srcs = ["mode_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The message-to-codeword pipeline has no upstream vector file either — the same
# gap `mode_vectors` records — so these came from running the reference
# implementation at the same pin, through the same environment recipe.
py_library(
    name = "encoding_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "encoding_vectors.py",
    ],
)

# `small`, and unlike its siblings this one is sized from CI rather than argued
# up for margin. Three runs of this branch: 11.2 / 10.2 / 20.8 s on the CPU leg
# and 10.6 / 10.7 / 9.2 s on the GPU leg. The worst is 20.8 s against `small`'s
# 60 s — 35% of it, where ../../../../docs/reference/measurement.md moves a target
# up at half.
#
# Those CPU numbers are the 2.2x run-to-run spread that page describes, caught in
# the act: the first two runs would have argued this was a fifth of its budget.
# Do not re-derive the headroom from a subset of them — **a run past 30 s moves
# this to `medium`**, and the honest reading today is 1.4x of margin rather than
# the 5x the first two suggested.
#
# It sits under `mode_test` beside it because its traced leg compiles two
# width-24 compressions rather than a 25-chunk sponge. A later slice adding
# traced cases at the leaf shape should expect to pay what `mode_test` pays and
# re-check against a CI run, never against a workstation.
py_test(
    name = "encoding_test",
    size = "small",
    srcs = ["encoding_test.py"],
    deps = [
        ":encoding_vectors",
        ":harness",
        ":mode_vectors",
        "//sig_frx/hash/leansig:encoding",
        "//sig_frx/hash/leansig:params",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The family and the Merkle walk have no upstream vector file either, and one of
# the two references is a transcription of upstream's own `verify_path` loop
# because that function returns a bool rather than a root. Both the provenance
# and the round trip that gates the transcription live in the module.
py_library(
    name = "tweakable_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "tweakable_vectors.py",
    ],
)

# `large`, sized from CI, and the **GPU leg decides it** — the slower of the two
# and so the one ../../../../docs/reference/measurement.md points at. Two CI runs
# of this PR: 54.8 / 54.2 s on the CPU leg, and **86.1 / 152.2 s on the GPU leg**.
# The worst is 152.2 s, which is 51% of `medium`. Past half takes the next bucket.
# The 3.4x executor factor deliberately does not apply here — that one is the CPU
# leg's, and the CPU leg is not deciding.
#
# **That 1.77x GPU spread is worth more than this target.** measurement.md sets
# its half-of-budget threshold having measured the GPU leg's run-to-run variation
# at 1.07x, and calls that steadiness "a property of a quiet box rather than of
# the leg". These two runs are 1.77x apart, and the whole GPU leg went 5m30s ->
# 14m15s between them, so the box was not quiet for the second. The threshold
# still holds — it is deliberately coarse — but a target sized from one GPU run
# on the strength of that 1.07x figure is sized from the wrong number. This one
# read 29% of `medium` on its first CI run and 51% on its second.
#
# Local runs said the same thing less precisely and were right: 132.7 / 129.9 /
# 115.7 s on a workstation, worst-case 44% of `medium`, which is what the page
# means by a local GPU number sizing a budget without settling a bucket boundary.
#
# The cost is compile, not arithmetic, and it is spread rather than concentrated
# — per class on a local GPU leg, over a ~12 s process start: the tree walk 28 s
# (a `TEST` leaf and eight vmapped width-24 levels in one graph), the `PROD` leaf
# 15 s, the tree 16 s, the chain walk 11 s, the two compressions 5 s each. There
# is no single case that trimming would meaningfully shorten.
py_test(
    name = "tweakable_test",
    size = "large",
    srcs = ["tweakable_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        ":tweakable_vectors",
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash:wots",
        "//sig_frx/hash/leansig:params",
        "//sig_frx/hash/leansig:tweakable",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The wire format is the one leanSig layer the fixtures archive covers, so these
# are transcribed from a published file rather than produced by a driver — except
# the `TEST` preset, which the archive does not carry. Both provenances, and the
# recipe for the second, live in the module.
py_library(
    name = "ssz_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "ssz_vectors.py",
    ],
)

# `small`: 5.7 s on the CPU leg and 5.8 s on the GPU one, the cheapest target in
# the package because the codec compiles no permutation at all — the whole of it
# is a reshape, a shift and a sum. Even at the 2.3x this GPU leg has been
# measured at under load that is 13 s, a fifth of the 60 s budget, well inside
# the half-a-budget rule in ../../../../docs/reference/measurement.md.
py_test(
    name = "ssz_test",
    size = "small",
    srcs = ["ssz_test.py"],
    deps = [
        ":harness",
        ":mode_vectors",
        ":ssz_vectors",
        "//sig_frx/hash/leansig:field",
        "//sig_frx/hash/leansig:params",
        "//sig_frx/hash/leansig:ssz",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
