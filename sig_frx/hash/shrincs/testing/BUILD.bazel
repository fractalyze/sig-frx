load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# SHRINCS publishes no vectors, so these are transcribed from the reference
# implementation its specification names as normative, pinned to a commit. The
# provenance is the module docstring; there is no file to fetch.
py_library(
    name = "vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "vectors.py",
    ],
)

# `medium` on the executor rather than on this measurement. The CPU leg here is
# 10.0 s — every verification shares one batch shape, so the suite pays one
# compile of the verification program and not one per distinct `B` — and bazel
# reports the size as oversized on that basis. It stays `medium` until CI says
# otherwise: this package measures 2.1-2.7x slower on the executor and the GPU
# leg is the one that compiles worst, which together put the worst run near
# `small`'s 60 s. Sized from the slowest leg's worst run, per
# ../../../../docs/reference/conventions.md.
py_test(
    name = "stateless_test",
    size = "medium",
    srcs = ["stateless_test.py"],
    deps = [
        ":vectors",
        "//sig_frx/hash/shrincs:stateless",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "stateful_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "stateful_vectors.py",
    ],
)

# `medium`, decided by the GPU leg: 9.4 s to 26.4 s there across runs against
# 4.4 s on CPU, and the top of that range is 44% of `small`'s 60 s before any
# further spread. Sized from the worst run. This workstation's GPU
# measures within a few percent of CI's for the targets whose numbers are
# recorded — `slh_dsa_traced_test` is 182.2 s here against 177.7 s there — so the
# 2.1-2.7x executor factor in this repo's other comments is the CPU leg's and
# does not apply on top. Sized from the slowest leg's worst run, per
# ../../../../docs/reference/conventions.md.
py_test(
    name = "wots_c_test",
    size = "medium",
    srcs = ["wots_c_test.py"],
    deps = [
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs:wots_c",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium` on the GPU leg's worst run, 53.7 s against 23.1 s on a quiet one
# (9.7 s on CPU) — 18% of its 300 s. The walk
# runs to the format's full 255 steps for every entry, so this is a floor rather
# than a function of the cases.
py_test(
    name = "fxmss_test",
    size = "medium",
    srcs = ["fxmss_test.py"],
    deps = [
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs:fxmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium` on the GPU leg's worst run, 110.4 s against 63.1 s on a quiet one
# (28.3 s on CPU) — 37% of its 300 s at the top, which clears the
# half-a-budget rule. Every entry of every call runs both signing paths, so
# the seam's test is the package's dearest by construction.
py_test(
    name = "shrincs_test",
    size = "medium",
    srcs = ["shrincs_test.py"],
    deps = [
        ":stateful_vectors",
        ":vectors",
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:fxmss",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
