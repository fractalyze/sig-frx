load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# SHRINCS publishes no vectors, so these are transcribed from the reference
# implementation its specification names as normative, pinned to a commit. The
# provenance is the module docstring; there is no file to fetch.
py_library(
    name = "vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "vectors.py",
    ],
)

# How a recorded case becomes what the seam takes: one batch width with the
# padding that holds it, and the header slice a component's input needs. Split
# out of the test files rather than left in each, because the two that had it had
# argued the same rationale in different words — and because the header offset
# belongs to `shrincs.py`, not to four restatements of 17.
py_library(
    name = "harness",
    testonly = True,
    srcs = [
        "__init__.py",
        "harness.py",
    ],
    deps = [
        ":stateful_vectors",
        "//sig_frx/hash/shrincs",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# `medium`, decided by the CPU leg: 105.1 s worst across this branch's three CI
# runs against 89.6 s on the GPU leg, which is 35% of the 300 s budget. Signing
# landed here since the last sizing and one stateless signature is 5776 bytes of
# FORS and hypertree, which is why `SigningTest` makes one and not one per case;
# every verification still shares one batch shape, so the suite pays one compile
# of the verification program and not one per distinct `B`.
#
# A local run did not decide this. The executor factor is per-target — 3.9x for
# this one — so a local CPU number cannot size a CPU-decided budget, per
# ../../../../docs/reference/measurement.md.
py_test(
    name = "stateless_test",
    size = "medium",
    srcs = ["stateless_test.py"],
    deps = [
        ":harness",
        ":vectors",
        "//sig_frx/hash/shrincs:stateless",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "stateful_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "stateful_vectors.py",
    ],
)

# `medium`, decided by the GPU leg: 37.8 s worst across this branch's three CI
# runs against 23.3 s on the CPU leg — 13% of the 300 s budget, and the cheapest
# target in the package because the signer's tests here add one leaf per case.
# It clears `small`'s 60 s by less than the CPU leg's spread across runs of one
# commit, so it stays where it is. Sized from the slowest leg's worst run, per
# ../../../../docs/reference/measurement.md.
py_test(
    name = "wots_c_test",
    size = "medium",
    srcs = ["wots_c_test.py"],
    deps = [
        ":harness",
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs:wots_c",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium`, decided by the CPU leg: 86.2 s worst across this branch's three CI
# runs against 81.7 s on the GPU leg — 29% of the 300 s budget. The verify walk
# runs to the format's full 255 steps for every entry, so that half is a floor
# rather than a function of the cases; the signer's half is not, and it is why
# `SignerTest` builds every case's root but signs one case per shape. Sized from
# the slowest leg's worst run, per ../../../../docs/reference/measurement.md.
py_test(
    name = "fxmss_test",
    size = "medium",
    srcs = ["fxmss_test.py"],
    deps = [
        ":harness",
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:fxmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `large`, and the CPU leg is what decides it. Across this branch's three CI runs
# the worst was 267.6 s against a `medium` budget of 300 s — 89% of it, where
# ../../../../docs/reference/measurement.md moves a target up at half — and the
# CPU leg's spread across runs of one commit is a median 2.2x, so the run that
# times out is one that has not happened yet. The GPU leg is the quieter one
# here, 114.7-162.6 s. A local measurement would have kept this at `medium`:
# the executor factor is per-target, which is why that page says a local number
# does not size a CPU-decided budget.
#
# It is the package's dearest test by construction — every entry of every call
# runs both signing paths — and the signer adds an FXMSS tree per case on top.
# The tests that need only a secret key build the 82 bytes from what a case
# records rather than calling `keygen`, which is a tree each; without that it
# would be dearer still.
py_test(
    name = "shrincs_test",
    size = "large",
    srcs = ["shrincs_test.py"],
    deps = [
        ":harness",
        ":stateful_vectors",
        ":vectors",
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:fxmss",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Verification under `frx.jit`. Its own target for the reason
# `slh_dsa_traced_test` is: the cost here is compilation rather than hashing, and
# it is most of this target's runtime. `large`, decided by the CPU leg: 180.1 s
# against 65.3 s on the GPU leg, which is 20% of the 900 s budget. A local
# number could not have sized this — the executor factor is the CPU leg's, per
# `measurement.md`.
py_test(
    name = "shrincs_traced_test",
    size = "large",
    srcs = ["shrincs_traced_test.py"],
    deps = [
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:fxmss",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Where verification spends its time. A dev tool rather than a test — it asserts
# nothing, and the numbers belong on the issue that acts on them — but it is
# committed so a re-measurement after the walk changes compares against the same
# harness rather than a fresh one. Same reason its SLH-DSA sibling is committed.
py_binary(
    name = "verify_bench",
    testonly = True,
    srcs = ["verify_bench.py"],
    deps = [
        ":harness",
        ":stateful_vectors",
        "//sig_frx/hash:bytestring",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:adrs",
        "//sig_frx/hash/shrincs:fxmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
