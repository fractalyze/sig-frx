load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# SHRINCS publishes no vectors, so these are transcribed from the reference
# implementation its specification names as normative, pinned to a commit. The
# provenance is the module docstring; there is no file to fetch.
py_library(
    name = "vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "vectors.py",
    ],
)

# `medium` on the executor rather than on this measurement. 26.7 s on CPU and
# 32.2 s on GPU since signing landed, up from 10.0 s CPU: one stateless signature
# is 5776 bytes of FORS and hypertree, which is why `SigningTest` makes one and
# not one per case. Every verification still shares one batch shape, so the suite
# pays one compile of the verification program and not one per distinct `B`. At
# the 2.1-2.7x this package measures slower on the executor that puts the worst
# run past `small`'s 60 s. Sized from the slowest leg's worst run, per
# ../../../../docs/reference/conventions.md.
py_test(
    name = "stateless_test",
    size = "medium",
    srcs = ["stateless_test.py"],
    deps = [
        ":vectors",
        "//sig_frx/hash/shrincs:stateless",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "stateful_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "stateful_vectors.py",
    ],
)

# `medium`, decided by the GPU leg: 9.4 s to 26.4 s there across runs against
# 5.8 s on CPU (7.8 s GPU and 4.4 s CPU before the signer's tests, which add one
# leaf per case and cost little), and the top of that range is 44% of `small`'s
# 60 s before any further spread. Sized from the worst run. This workstation's GPU
# measures within a few percent of CI's for the targets whose numbers are
# recorded — `slh_dsa_traced_test` is 182.2 s here against 177.7 s there — so the
# 2.1-2.7x executor factor in this repo's other comments is the CPU leg's and
# does not apply on top. Sized from the slowest leg's worst run, per
# ../../../../docs/reference/conventions.md.
py_test(
    name = "wots_c_test",
    size = "medium",
    srcs = ["wots_c_test.py"],
    deps = [
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs:wots_c",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium` on the GPU leg's worst run, 53.7 s against 26.7 s on a quiet one
# (19.9 s on CPU, up from 9.7 s) — 18% of its 300 s. The verify walk runs to the
# format's full 255 steps for every entry, so that half is a floor rather than a
# function of the cases; the signer's half is not, and it is why `SignerTest`
# builds every case's root but signs one case per shape.
py_test(
    name = "fxmss_test",
    size = "medium",
    srcs = ["fxmss_test.py"],
    deps = [
        ":stateful_vectors",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/shrincs:fxmss",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# `medium` on the GPU leg's worst run, 110.4 s against 84.2 s on a quiet one
# (60.0 s on CPU, up from 28.3 s) — 37% of its 300 s at the top, which clears the
# half-a-budget rule. Every entry of every call runs both signing paths, so the
# seam's test is the package's dearest by construction, and the signer adds a
# whole FXMSS tree per case on top. The tests that only need a secret key build
# the 82 bytes from what a case records rather than calling `keygen` for them,
# which is a tree each.
py_test(
    name = "shrincs_test",
    size = "medium",
    srcs = ["shrincs_test.py"],
    deps = [
        ":stateful_vectors",
        ":vectors",
        "//sig_frx/hash/shrincs",
        "//sig_frx/hash/shrincs:fxmss",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
