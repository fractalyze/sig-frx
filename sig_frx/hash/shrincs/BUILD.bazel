load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# SHRINCS — a stateful hash-based signature with a stateless fallback, under one
# public key. The stateless half is SLH-DSA at a parameter set FIPS 205 does not
# publish, so it depends on `//sig_frx/hash/slhdsa` and adds a wrapper rather
# than reimplementing anything.
py_library(
    name = "stateless",
    srcs = [
        "__init__.py",
        "stateless.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash/slhdsa:slh_dsa",
        "@hash_frx//hash_frx",
        requirement("frx"),
    ],
)

py_library(
    name = "adrs",
    srcs = [
        "__init__.py",
        "adrs.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sig_frx/hash:adrs",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# WOTS+C, the one-time signature the stateful path signs with. The chain walk is
# `//sig_frx/hash:wots`'s under a different address; what lands here is the map
# from a message digest to a constant-sum index set.
py_library(
    name = "wots_c",
    srcs = [
        "__init__.py",
        "wots_c.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":adrs",
        "//sig_frx/hash:adrs_encoding",
        "//sig_frx/hash:tweakable",
        "//sig_frx/hash:wots",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The FXMSS tree. The verification walk is not `//sig_frx/hash:tree`'s: the leaf
# index is 64 bits where that one takes a lane-wide column, and the depth varies
# per entry where that one is a fixed height. Key generation is the other way
# around — a balanced tree is an ordinary Merkle forest — so the dependency is
# the signer's.
py_library(
    name = "fxmss",
    srcs = [
        "__init__.py",
        "fxmss.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":adrs",
        ":wots_c",
        "//sig_frx/hash:bytestring",
        "//sig_frx/hash:tree",
        "//sig_frx/hash:tweakable",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The assembled scheme: the indicator byte that chooses a path, and the select
# that runs both and keeps each entry's verdict.
py_library(
    name = "shrincs",
    srcs = [
        "__init__.py",
        "shrincs.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fxmss",
        ":stateless",
        "//sig_frx:context",
        "//sig_frx:hashes",
        "//sig_frx/hash:tweakable",
        "@hash_frx//hash_frx",
        requirement("frx"),
        requirement("numpy"),
    ],
)
