# The gate on published bytes: reproducing a key NIST published is what confirms
# every reading the components beneath SLH-DSA were written from. Vectors are
# fetched and sha256-pinned in //MODULE.bazel rather than committed.
py_test(
    name = "slh_dsa_kat_test",
    size = "medium",
    srcs = ["slh_dsa_kat_test.py"],
    data = [
        "@acvp_slh_dsa_keygen_expected//file",
        "@acvp_slh_dsa_keygen_prompt//file",
    ],
    deps = [
        "//sig_frx/hashbased:slh_dsa",
        "//sig_frx/testing:kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

