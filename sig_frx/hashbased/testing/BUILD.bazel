load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "adrs_test",
    size = "small",
    srcs = ["adrs_test.py"],
    deps = [
        "//sig_frx/hashbased:adrs",
        "//sig_frx/hashbased:adrs_encoding",
        requirement("absl_py"),
        requirement("numpy"),
    ],
)

# RFC 8391 publishes no vectors, so the gate is the reference implementation §7
# points at, digested the way its own `test/vectors.c` prints. The values are
# committed constants with their provenance in the module docstring rather than a
# fetched file — there is no published file to fetch.
py_library(
    name = "rfc8391_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "rfc8391_vectors.py",
    ],
    deps = [requirement("numpy")],
)

py_test(
    name = "rfc8391_adrs_test",
    size = "small",
    srcs = ["rfc8391_adrs_test.py"],
    deps = [
        ":rfc8391_vectors",
        "//sig_frx/hashbased:rfc8391_adrs",
        requirement("absl_py"),
        requirement("numpy"),
    ],
)

py_test(
    name = "rfc8391_hashes_test",
    size = "small",
    srcs = ["rfc8391_hashes_test.py"],
    deps = [
        ":rfc8391_vectors",
        "//sig_frx/hashbased:rfc8391_adrs",
        "//sig_frx/hashbased:rfc8391_hashes",
        "//sig_frx/hashbased:rfc8391_params",
        "//sig_frx/hashbased:tweakable",
        "@hash_frx//hash_frx:sha256",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The gate the substrate is finished against: a WOTS+ public key, a signature and
# an L-tree leaf reproducing the reference's digests at both runnable OIDs.
py_test(
    name = "rfc8391_wots_test",
    size = "medium",
    srcs = ["rfc8391_wots_test.py"],
    deps = [
        ":rfc8391_vectors",
        "//sig_frx/hashbased:rfc8391_adrs",
        "//sig_frx/hashbased:rfc8391_hashes",
        "//sig_frx/hashbased:rfc8391_params",
        "//sig_frx/hashbased:rfc8391_wots",
        "@hash_frx//hash_frx:sha256",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The scheme gate: the reference's XMSS public key and signature digests, made at
# a non-zero index, plus the rejection cases a round trip cannot show.
py_test(
    name = "rfc8391_xmss_test",
    size = "large",
    srcs = ["rfc8391_xmss_test.py"],
    deps = [
        ":rfc8391_vectors",
        "//sig_frx/hashbased:rfc8391_adrs",
        "//sig_frx/hashbased:rfc8391_hashes",
        "//sig_frx/hashbased:rfc8391_params",
        "//sig_frx/hashbased:rfc8391_wots",
        "//sig_frx/hashbased:rfc8391_xmss",
        "//sig_frx/hashbased:tree",
        "@hash_frx//hash_frx:sha256",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The multi-tree half: the per-layer index split, keygen over the top tree only,
# and the wider signature. Single-tree is the `d = 1` case of the same class and
# is gated by `rfc8391_xmss_test`.
py_test(
    name = "rfc8391_xmssmt_test",
    size = "medium",
    srcs = ["rfc8391_xmssmt_test.py"],
    deps = [
        ":rfc8391_vectors",
        "//sig_frx/hashbased:rfc8391_params",
        "//sig_frx/hashbased:rfc8391_xmss",
        requirement("absl_py"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

