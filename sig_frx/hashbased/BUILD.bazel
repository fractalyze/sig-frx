# The RFC 8391 side. It shares `wots.chain` and the tree walk with FIPS 205 and
# nothing else: the addresses, the hash family and the public-key compression all
# differ, which is what these targets carry.
py_library(
    name = "rfc8391_params",
    srcs = [
        "__init__.py",
        "rfc8391_params.py",
    ],
    visibility = ["//visibility:public"],
    deps = [":wots"],
)

py_library(
    name = "rfc8391_hashes",
    srcs = [
        "__init__.py",
        "rfc8391_hashes.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":rfc8391_adrs",
        ":rfc8391_params",
        "@hash_frx//hash_frx:byte_hash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

