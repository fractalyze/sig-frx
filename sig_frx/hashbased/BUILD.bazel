load("@rules_python//python:defs.bzl", "py_library")
load("@sig_frx_pip//:requirements.bzl", "requirement")

# Addresses are structural and hash-free: every component builds them before any
# hashing starts, so these depend on no hash. They do depend on frx, because the
# fields they pack are host integers on the signing path and traced values on the
# verification path, and the packing runs where the fields already live.
py_library(
    name = "adrs_encoding",
    srcs = [
        "__init__.py",
        "adrs_encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":bytestring",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "bytestring",
    srcs = [
        "__init__.py",
        "bytestring.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "adrs",
    srcs = [
        "__init__.py",
        "adrs.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":adrs_encoding",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "rfc8391_adrs",
    srcs = [
        "__init__.py",
        "rfc8391_adrs.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":adrs_encoding",
        requirement("numpy"),
    ],
)

py_library(
    name = "tweakable",
    srcs = [
        "__init__.py",
        "tweakable.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@hash_frx//hash_frx:byte_hash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
