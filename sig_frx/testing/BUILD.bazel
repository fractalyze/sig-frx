load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The stand-in every seam- and harness-level test drives. Not a signature scheme;
# see its docstring.
py_library(
    name = "checksum_scheme",
    testonly = True,
    srcs = [
        "__init__.py",
        "checksum_scheme.py",
    ],
    visibility = ["//sig_frx:__subpackages__"],
    deps = [
        "//sig_frx:context",
        "//sig_frx:signature",
        requirement("frx"),
    ],
)

# The known-answer harness. testonly, and deliberately not part of the shipped
# package: a consumer runs schemes, not their gate.
py_library(
    name = "kat",
    testonly = True,
    srcs = [
        "__init__.py",
        "kat.py",
    ],
    visibility = ["//sig_frx:__subpackages__"],
    deps = [
        "//sig_frx:signature",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# What sits between `:kat` and a scheme: a published set covers several operations
# and the harness runs one, so the cases get split by operation and each is handed
# the thing that performs it. Shared because FIPS 204 and FIPS 205 publish the
# same shape.
py_library(
    name = "vector_sets",
    testonly = True,
    srcs = [
        "__init__.py",
        "vector_sets.py",
    ],
    visibility = ["//sig_frx:__subpackages__"],
    deps = [
        ":kat",
        "//sig_frx:context",
        "//sig_frx:prehash",
        "//sig_frx:signature",
        requirement("frx"),
    ],
)

py_test(
    name = "signature_test",
    size = "small",
    srcs = ["signature_test.py"],
    deps = [
        ":checksum_scheme",
        "//sig_frx:signature",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "kat_test",
    size = "small",
    srcs = ["kat_test.py"],
    deps = [
        ":checksum_scheme",
        ":kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Runs the loader over NIST's published files, fetched and sha256-pinned in
# //MODULE.bazel rather than committed (they run to tens of megabytes).
py_test(
    name = "acvp_vectors_test",
    size = "small",
    srcs = ["acvp_vectors_test.py"],
    data = [
        "@acvp_ml_dsa_sigver_expected//file",
        "@acvp_ml_dsa_sigver_prompt//file",
        "@acvp_slh_dsa_keygen_expected//file",
        "@acvp_slh_dsa_keygen_prompt//file",
    ],
    deps = [
        ":checksum_scheme",
        ":kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//sig_frx",
        requirement("absl_py"),
    ],
)

# The hash-frx wiring guard: the only target that reaches across the module pin
# into @hash_frx, so a broken dependency fails here rather than inside a scheme.
py_test(
    name = "hash_frx_dep_test",
    size = "small",
    srcs = ["hash_frx_dep_test.py"],
    deps = [
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The selection `hashes` makes, and that the schemes take what it selects. The
# byte-equality it has to preserve is gated by `sampling_test` and the
# known-answer tests, which is why none of it is repeated here: a correct digest
# is a correct digest whichever implementation computed it, so those would pass
# against a selection that is inverted or constant.
py_test(
    name = "hashes_test",
    size = "medium",
    srcs = ["hashes_test.py"],
    deps = [
        "//sig_frx:hashes",
        "//sig_frx/lattice/mldsa:ml_dsa",
        "//sig_frx/lattice/mldsa:sampling",
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The line between a caller mistake and a verdict, which six schemes' `verify`
# used to draw separately. `small`: the batch preamble is shape arithmetic over
# operands a few bytes wide, and the one traced case compiles a slice.
py_test(
    name = "batch_test",
    size = "small",
    srcs = ["batch_test.py"],
    deps = [
        "//sig_frx:batch",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
