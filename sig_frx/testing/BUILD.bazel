load("@rules_python//python:defs.bzl", "py_test")
load("@sig_frx_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "signature_test",
    size = "small",
    srcs = ["signature_test.py"],
    deps = [
        "//sig_frx:signature",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//sig_frx",
        requirement("absl_py"),
    ],
)

# The hash-frx wiring guard: the only target that reaches across the module pin
# into @hash_frx, so a broken dependency fails here rather than inside a scheme.
py_test(
    name = "hash_frx_dep_test",
    size = "small",
    srcs = ["hash_frx_dep_test.py"],
    deps = [
        "@hash_frx//hash_frx",
        "@hash_frx//hash_frx:byte_hash",
        "@hash_frx//hash_frx:linear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
